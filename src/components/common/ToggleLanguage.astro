---
export interface Props {
  label?: string;
  class?: string;
}

const { label = 'Language', class: className = '' } = Astro.props;
---

<div
  class:list={['language-toggle inline-flex min-h-11 items-center gap-0.5', className]}
  role="radiogroup"
  aria-label={label}
>
  <button
    type="button"
    class="language-toggle__option"
    role="radio"
    aria-checked="false"
    aria-label="中文"
    data-aw-lang-btn="zh"
  >
    中
  </button>
  <span class="language-toggle__divider" aria-hidden="true">/</span>
  <button
    type="button"
    class="language-toggle__option"
    role="radio"
    aria-checked="false"
    aria-label="English"
    data-aw-lang-btn="en"
  >
    EN
  </button>
</div>

<style>
  .language-toggle__option {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.35rem;
    color: var(--rc-text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.025em;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .language-toggle__option:hover,
  .language-toggle__option[data-active] {
    color: var(--rc-text-strong);
  }

  .language-toggle__option:active {
    transform: translateY(1px);
  }

  .language-toggle__option:focus-visible {
    outline: 2px solid var(--rc-focus);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .language-toggle__divider {
    color: var(--rc-text-faint);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }
</style>
