---
import Button from '~/components/ui/Button.astro';
import StarBorder from '~/components/ui/StarBorder.astro';
import DotFieldBackground from './DotFieldBackground.astro';
---

<section class="community-cta" aria-labelledby="community-cta-title">
  <DotFieldBackground />
  <div class="community-cta__shell">
    <div class="community-cta__copy">
      <h2
        id="community-cta-title"
        data-lang-zh="加入科大讯飞开源社区"
        data-lang-en="Join the iFLYTEK Open Source Community"
      >
        加入科大讯飞开源社区
      </h2>
      <p data-lang-zh="与我们一起构建更好的 AI 开源生态" data-lang-en="Build a better AI open source ecosystem with us">
        与我们一起构建更好的 AI 开源生态
      </p>
    </div>

    <div class="community-cta__actions" aria-label="Community links">
      <StarBorder class="community-star-border">
        <Button
          variant="secondary"
          href="https://github.com/iflytek"
          target="_blank"
          icon="tabler:brand-github"
          class="community-action star-border__action"
          text='<span data-lang-zh="在 GitHub 上关注我们" data-lang-en="Follow us on GitHub">在 GitHub 上关注我们</span>'
        />
      </StarBorder>
      <StarBorder class="community-star-border">
        <Button
          variant="secondary"
          href="https://discord.gg/UgnuzaJKwc"
          target="_blank"
          icon="tabler:brand-discord"
          class="community-action star-border__action"
          text='<span data-lang-zh="加入 Discord" data-lang-en="Join Discord">加入 Discord</span>'
        />
      </StarBorder>
    </div>
  </div>
</section>

<style>
  .community-cta {
    position: relative;
    display: grid;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(30rem, 42vw, 36rem);
    padding: clamp(3.5rem, 6vw, 5rem) 0;
    align-items: center;
    background: var(--rc-canvas);
    color: var(--rc-text);
  }

  .community-cta__shell {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(calc(100% - 3rem), 87.5rem);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: clamp(3rem, 6vw, 6rem);
  }

  .community-cta__copy {
    display: grid;
    max-width: 58rem;
    gap: 1.25rem;
  }

  h2 {
    max-width: 58rem;
    margin: 0;
    color: var(--rc-text-strong);
    font-size: var(--rc-type-section-heading);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1.06;
    text-wrap: balance;
  }

  p {
    max-width: 38rem;
    margin: 0;
    color: var(--rc-text-muted);
    font-size: 1rem;
    line-height: 1.68;
  }

  .community-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
    gap: 0.75rem;
  }

  :global(.community-star-border) {
    width: auto;
    flex: 0 0 auto;
    border-radius: var(--rc-radius-surface);
  }

  :global(.community-star-border .community-action) {
    width: auto;
    min-height: 3rem;
    gap: 0.5rem;
    padding-inline: 1.25rem;
    border-radius: var(--rc-radius-control);
    font-size: var(--rc-type-label);
    letter-spacing: 0;
    white-space: nowrap;
  }

  :global(.community-star-border .community-action svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  @media (max-width: 62rem) {
    .community-cta__shell {
      width: min(calc(100% - 2rem), 48rem);
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      row-gap: 2rem;
    }

    .community-cta__actions {
      justify-content: flex-start;
      justify-self: start;
    }
  }

  @media (max-width: 42rem) {
    .community-cta {
      min-height: 30rem;
      padding: 3.5rem 0 3rem;
    }

    .community-cta__shell {
      width: min(calc(100% - 1.5rem), 36rem);
      row-gap: 1.5rem;
    }

    .community-cta__copy {
      gap: 1rem;
    }

    h2 {
      line-height: 1.12;
    }

    p {
      line-height: 1.6;
    }

    .community-cta__actions {
      justify-content: flex-start;
      gap: 0.625rem;
    }

    :global(.community-star-border .community-action) {
      padding-inline: 1rem;
    }
  }
</style>
