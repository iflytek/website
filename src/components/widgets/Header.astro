---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleLanguage from '~/components/common/ToggleLanguage.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import SearchButton from '~/components/common/SearchButton.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink, trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  textEn?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  i18nKey?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleLanguage?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isFullWidth = false,
  showToggleLanguage = false,
} = Astro.props;

const pathname = new URL(Astro.url).pathname;
const currentPath = pathname === '/' ? '/' : `/${trimSlash(pathname)}`;
const isActive = (href?: string) => Boolean(href && href === currentPath);
---

<header
  id={id}
  class:list={['site-header', { 'site-header--sticky': isSticky }]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
>
  <div class:list={['site-header__shell', { 'site-header__shell--full': isFullWidth }]}>
    <a class="site-header__brand" href={getHomePermalink()} aria-label="iFLYTEK Open Source home">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <ul class="site-nav__list">
        {
          links.map(({ text, textEn, href, links: subLinks }) => {
            const parentActive = isActive(href) || Boolean(subLinks?.some((item) => isActive(item.href)));
            return (
              <li class:list={['site-nav__item', { 'site-nav__item--dropdown': subLinks?.length }]}>
                {href ? (
                  <a
                    class:list={['site-nav__link', { 'is-active': parentActive }]}
                    href={href}
                    aria-current={isActive(href) ? 'page' : undefined}
                  >
                    <span data-lang-zh={text} data-lang-en={textEn || text}>
                      {text}
                    </span>
                    {subLinks?.length ? <Icon name="tabler:chevron-down" class="h-3.5 w-3.5" /> : null}
                  </a>
                ) : (
                  <button type="button" class="site-nav__link">
                    <span data-lang-zh={text} data-lang-en={textEn || text}>
                      {text}
                    </span>
                    {subLinks?.length ? <Icon name="tabler:chevron-down" class="h-3.5 w-3.5" /> : null}
                  </button>
                )}

                {subLinks?.length ? (
                  <ul class="site-nav__dropdown">
                    {subLinks.map(({ text: childText, textEn: childTextEn, href: childHref }) => (
                      <li>
                        <a
                          class:list={['site-nav__dropdown-link', { 'is-active': isActive(childHref) }]}
                          href={childHref}
                          aria-current={isActive(childHref) ? 'page' : undefined}
                        >
                          <span data-lang-zh={childText} data-lang-en={childTextEn || childText}>
                            {childText}
                          </span>
                          <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" />
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__utilities">
      <SearchButton />
      {
        showToggleLanguage ? (
          <div class="site-header__language">
            <ToggleLanguage />
          </div>
        ) : null
      }
      <div class="site-header__menu-button">
        <ToggleMenu
          label="Open navigation"
          labelZh="打开导航"
          labelEn="Open navigation"
          controls="mobile-drawer"
          class="header-icon-button site-header__menu-toggle group"
        />
      </div>
      {
        actions?.length ? (
          <div class="site-header__actions">
            {actions.map((buttonProps) => (
              <Button {...buttonProps} class="min-h-11 px-5 text-sm" />
            ))}
          </div>
        ) : null
      }
    </div>
  </div>

  <div id="drawer-backdrop" class="mobile-drawer-backdrop" aria-hidden="true"></div>

  <aside id="mobile-drawer" class="mobile-drawer" aria-label="Mobile navigation" aria-hidden="true" inert tabindex="-1">
    <div class="mobile-drawer__header">
      <a href={getHomePermalink()} aria-label="iFLYTEK Open Source home"><Logo /></a>
      <button type="button" id="drawer-close-btn" class="header-icon-button">
        <span class="sr-only" data-lang-zh="关闭导航" data-lang-en="Close navigation">关闭导航</span>
        <Icon name="tabler:x" class="h-5 w-5" />
      </button>
    </div>

    <nav class="mobile-drawer__nav" aria-label="Mobile site navigation">
      <ul class="drawer-tree">
        {
          links.map(({ text, textEn, href, links: subLinks }) => {
            const parentActive = isActive(href) || Boolean(subLinks?.some((item) => isActive(item.href)));
            return (
              <li class:list={['drawer-tree__section', { 'has-children': subLinks?.length }]}>
                <a
                  class:list={['drawer-tree__parent', { 'is-active': parentActive }]}
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                >
                  <span data-lang-zh={text} data-lang-en={textEn || text}>
                    {text}
                  </span>
                  {subLinks?.length ? (
                    <span class="drawer-tree__count">{String(subLinks.length).padStart(2, '0')}</span>
                  ) : null}
                </a>
                {subLinks?.length ? (
                  <ul class="drawer-tree__children">
                    {subLinks.map(({ text: childText, textEn: childTextEn, href: childHref }) => (
                      <li>
                        <a
                          class:list={['drawer-tree__link', { 'is-active': isActive(childHref) }]}
                          href={childHref}
                          aria-current={isActive(childHref) ? 'page' : undefined}
                        >
                          <span data-lang-zh={childText} data-lang-en={childTextEn || childText}>
                            {childText}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="mobile-drawer__footer">
      {showToggleLanguage ? <ToggleLanguage /> : null}
    </div>
  </aside>
</header>

<style is:global>
  .site-header {
    z-index: 50;
    width: 100%;
    padding: 0.75rem 1.5rem 0;
    font-family:
      var(--aw-font-sans, 'Inter Variable'), 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', ui-sans-serif, system-ui,
      sans-serif;
    transition: padding 180ms ease;
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .site-header.scroll {
    padding-top: 0.5rem;
  }

  .site-header__shell {
    display: flex;
    width: 100%;
    max-width: var(--rc-max-width);
    height: 3.875rem;
    margin: 0 auto;
    align-items: center;
    gap: clamp(0.875rem, 1.4vw, 1.75rem);
    padding: 0 1.75rem;
    border: 1px solid color-mix(in srgb, var(--rc-text) 14%, transparent);
    border-radius: 11px;
    background: rgb(5 5 9 / 96%);
    box-shadow: 0 12px 30px rgb(0 0 0 / 24%);
  }

  .site-header.scroll .site-header__shell {
    border-color: color-mix(in srgb, var(--rc-text) 22%, transparent);
    box-shadow: 0 16px 42px rgb(0 0 0 / 44%);
  }

  .site-header__shell--full {
    max-width: none;
  }

  .site-header__brand {
    display: flex;
    min-width: 12rem;
    flex: 0 1 auto;
    align-items: center;
  }

  .site-header .site-logo {
    gap: 0.625rem;
    color: var(--rc-text-strong);
    font-size: 1.18rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .lang-en .site-header .site-logo {
    letter-spacing: -0.012em;
  }

  .site-header .site-logo img {
    width: 1.875rem;
    height: 1.875rem;
  }

  .site-header__brand:focus-visible,
  .mobile-drawer__header > a:focus-visible {
    outline: 2px solid var(--rc-focus);
    outline-offset: 3px;
    border-radius: 5px;
  }

  .site-nav {
    min-width: 0;
    flex: 1 1 auto;
    align-self: stretch;
  }

  .site-nav__list {
    display: flex;
    height: 100%;
    align-items: stretch;
    gap: clamp(0.4rem, 1vw, 0.9rem);
  }

  .site-nav__item {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    min-width: 3.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0 0.75rem;
    color: var(--rc-text-muted);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.015em;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .site-nav__link::after {
    position: absolute;
    right: 0.8rem;
    bottom: -1px;
    left: 0.8rem;
    height: 2px;
    background: color-mix(in srgb, var(--rc-text-strong) 82%, transparent);
    content: '';
    opacity: 0;
    transform: scaleX(0.35);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--rc-text-strong);
  }

  .site-nav__link.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-nav__link:focus-visible,
  .site-nav__dropdown-link:focus-visible {
    outline: 2px solid var(--rc-focus);
    outline-offset: -2px;
    border-radius: 5px;
  }

  .site-nav__dropdown {
    position: absolute;
    top: calc(100% - 0.15rem);
    left: 50%;
    display: grid;
    min-width: 13.25rem;
    gap: 0.2rem;
    padding: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--rc-text) 16%, transparent);
    border-radius: 8px;
    background: #090a0f;
    box-shadow: 0 20px 52px rgb(0 0 0 / 48%);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .site-nav__item--dropdown:hover .site-nav__dropdown,
  .site-nav__item--dropdown:focus-within .site-nav__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .site-nav__dropdown-link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.75rem;
    border-radius: 5px;
    color: var(--rc-text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .site-nav__dropdown-link:hover,
  .site-nav__dropdown-link.is-active {
    background: rgb(255 255 255 / 5%);
    color: var(--rc-text-strong);
  }

  .site-header__utilities {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.25rem;
  }

  .site-header__language {
    position: relative;
    margin-left: 0.5rem;
  }

  .site-header__language::before {
    position: absolute;
    top: 0.7rem;
    bottom: 0.7rem;
    left: -0.4rem;
    width: 1px;
    background: color-mix(in srgb, var(--rc-text) 16%, transparent);
    content: '';
  }

  .site-header .header-icon-button {
    color: var(--rc-text-muted);
  }

  .site-header .header-icon-button:hover {
    background: rgb(255 255 255 / 5%);
    color: var(--rc-text-strong);
  }

  .site-header__menu-button {
    display: none;
  }

  .site-header__menu-toggle {
    flex-direction: column;
  }

  .mobile-drawer-backdrop {
    position: fixed;
    z-index: 55;
    inset: 0;
    background: rgb(0 0 0 / 72%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .mobile-drawer-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-drawer {
    position: fixed;
    z-index: 60;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    width: min(22rem, 88vw);
    flex-direction: column;
    border-left: 1px solid color-mix(in srgb, var(--rc-text) 14%, transparent);
    background: #07080c;
    box-shadow: -18px 0 60px rgb(0 0 0 / 46%);
    transform: translateX(100%);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-drawer.open {
    transform: translateX(0);
  }

  .mobile-drawer__header {
    display: flex;
    min-height: 4.5rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 0 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--rc-text) 10%, transparent);
  }

  .mobile-drawer__nav {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem;
  }

  .drawer-tree {
    display: grid;
    gap: 0.25rem;
  }

  .drawer-tree__section {
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--rc-text) 9%, transparent);
  }

  .drawer-tree__section:first-child {
    border-top: 0;
  }

  .drawer-tree__parent {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--rc-text-muted);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  .drawer-tree__parent:hover,
  .drawer-tree__parent.is-active {
    color: var(--rc-text-strong);
  }

  .drawer-tree__count {
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
  }

  .drawer-tree__children {
    position: relative;
    display: grid;
    gap: 0.125rem;
    padding: 0 0 0.75rem 1rem;
  }

  .drawer-tree__children::before {
    position: absolute;
    top: 0.2rem;
    bottom: 1rem;
    left: 0.2rem;
    width: 1px;
    background: color-mix(in srgb, var(--rc-text) 16%, transparent);
    content: '';
  }

  .drawer-tree__link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.75rem;
    border-radius: 5px;
    color: var(--rc-text-faint);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .drawer-tree__link:hover,
  .drawer-tree__link.is-active {
    background: rgb(255 255 255 / 5%);
    color: var(--rc-text-strong);
  }

  .drawer-tree__parent:focus-visible,
  .drawer-tree__link:focus-visible {
    outline: 2px solid var(--rc-focus);
    outline-offset: -2px;
  }

  .mobile-drawer__footer {
    display: flex;
    min-height: 4.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid color-mix(in srgb, var(--rc-text) 10%, transparent);
  }

  @media (max-width: 1279px) {
    .site-header {
      padding-inline: 1rem;
    }

    .site-header__shell {
      padding: 0 0.75rem 0 1rem;
    }

    .site-header__brand {
      min-width: 0;
      flex: 1 1 auto;
    }

    .site-nav,
    .site-header__language,
    .site-header__actions {
      display: none;
    }

    .site-header__menu-button {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .mobile-drawer,
    .mobile-drawer-backdrop {
      display: none !important;
    }
  }

  @media (max-width: 639px) {
    .site-header {
      padding: 0.5rem 0.5rem 0;
    }

    .site-header__shell {
      height: 3.75rem;
      border-radius: 8px;
    }

    .site-header .site-logo {
      gap: 0.5rem;
      font-size: 1rem;
    }

    .site-header .site-logo img {
      width: 1.625rem;
      height: 1.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__shell,
    .site-nav__dropdown,
    .mobile-drawer,
    .mobile-drawer-backdrop {
      transition-duration: 0.01ms;
    }
  }
</style>

<script is:inline>
  (() => {
    if (window.__iflyHeaderBound) return;
    window.__iflyHeaderBound = true;

    let returnFocus = null;
    let previousOverflow = '';
    let drawerIsOpen = false;

    const refs = () => ({
      drawer: document.getElementById('mobile-drawer'),
      backdrop: document.getElementById('drawer-backdrop'),
      trigger: document.querySelector('[data-aw-toggle-menu]'),
    });

    const focusable = (root) =>
      Array.from(
        root.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );

    function openDrawer() {
      const { drawer, backdrop, trigger } = refs();
      if (!drawer || !backdrop) return;
      if (drawerIsOpen || drawer.classList.contains('open')) {
        drawer.querySelector('#drawer-close-btn')?.focus();
        return;
      }

      returnFocus = document.activeElement;
      previousOverflow = document.body.style.overflow;
      drawerIsOpen = true;
      drawer.classList.add('open');
      backdrop.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      drawer.removeAttribute('inert');
      trigger?.setAttribute('aria-expanded', 'true');
      trigger?.setAttribute('aria-controls', 'mobile-drawer');
      trigger?.classList.add('expanded');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => drawer.querySelector('#drawer-close-btn')?.focus());
    }

    function closeDrawer(restore = true) {
      const { drawer, backdrop, trigger } = refs();
      const wasOpen = drawerIsOpen || Boolean(drawer?.classList.contains('open'));

      if (!drawer || !backdrop) {
        if (wasOpen) document.body.style.overflow = previousOverflow;
        drawerIsOpen = false;
        returnFocus = null;
        return;
      }

      drawer.classList.remove('open');
      backdrop.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('inert', '');
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.classList.remove('expanded');
      if (wasOpen) document.body.style.overflow = previousOverflow;
      drawerIsOpen = false;
      if (restore && returnFocus instanceof HTMLElement) returnFocus.focus();
      returnFocus = null;
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-aw-toggle-menu]')) {
        event.preventDefault();
        openDrawer();
      } else if (target.closest('#drawer-close-btn') || target.id === 'drawer-backdrop') {
        event.preventDefault();
        closeDrawer();
      } else if (target.closest('#mobile-drawer a')) {
        closeDrawer(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      const { drawer } = refs();
      if (!drawer?.classList.contains('open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusable(drawer);
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
      if (event.matches) closeDrawer(false);
    });
    document.addEventListener('search:opening', () => closeDrawer(false));
    document.addEventListener('astro:before-swap', () => closeDrawer(false));
    document.addEventListener('astro:after-swap', () => closeDrawer(false));
  })();
</script>
