---
interface Contributor {
  username: string;
  avatar_url: string;
  contributions: number;
  profile_url: string;
}

interface Props {
  contributors: Contributor[];
}

const { contributors } = Astro.props;
const contributorsJSON = JSON.stringify(contributors).replaceAll('<', '\\u003c');
---

<div class="contributors-field" data-contributors-canvas>
  <script is:inline type="application/json" data-contributors-payload set:html={contributorsJSON} />

  <div class="contributors-field__header" aria-hidden="true">
    <span>IFLYTEK / COMMUNITY FIELD</span>
    <span
      data-lang-zh={contributors.length + ' 位代码贡献者'}
      data-lang-en={contributors.length + ' code contributors'}
    >
      {contributors.length} 位代码贡献者
    </span>
  </div>

  <div class="contributors-field__stage" data-contributors-stage>
    <canvas data-contributors-surface width="1200" height="420" aria-hidden="true"></canvas>

    <div class="contributors-field__tooltip" data-contributors-tooltip aria-hidden="true" hidden>
      <img data-contributors-tooltip-avatar src="" alt="" width="36" height="36" />
      <span>
        <strong data-contributors-tooltip-name></strong>
        <small data-contributors-tooltip-stats></small>
      </span>
    </div>

    <div class="contributors-field__fallback">
      <strong aria-hidden="true">iFLYTEK</strong>
      <span
        data-lang-zh="动态头像墙需要 JavaScript；你仍可通过下方名单访问贡献者主页。"
        data-lang-en="The animated portrait field requires JavaScript. Contributor profiles remain available in the list below."
      >
        动态头像墙需要 JavaScript；你仍可通过下方名单访问贡献者主页。
      </span>
    </div>

    <div class="contributors-field__loading" data-contributors-loading aria-hidden="true">
      <span class="contributors-field__signal"></span>
      <span data-lang-zh="正在构建贡献者头像墙…" data-lang-en="Building the contributor portrait field…">
        正在构建贡献者头像墙…
      </span>
    </div>
  </div>

  <p
    class="contributors-field__caption"
    data-lang-zh="悬停可查看贡献者，点击或轻触头像可打开 GitHub 主页；完整主页目录见下方。"
    data-lang-en="Hover to identify a contributor, or click or tap an avatar to open their GitHub profile. The complete profile directory follows below."
  >
    悬停可查看贡献者，点击或轻触头像可打开 GitHub 主页；完整主页目录见下方。
  </p>
</div>

<script>
  interface ContributorRecord {
    username: string;
    avatar_url: string;
    contributions: number;
    profile_url: string;
  }

  interface Position {
    x: number;
    y: number;
  }

  interface Particle extends Position {
    targetX: number;
    targetY: number;
    startX: number;
    startY: number;
    size: number;
    image: CanvasImageSource;
    contributor: ContributorRecord;
    phase: number;
    progress: number;
  }

  interface CanvasRuntime {
    mountAll: () => void;
    destroyAll: () => void;
  }

  declare global {
    interface Window {
      __iflytekContributorsCanvasRuntime?: CanvasRuntime;
    }
  }

  function createContributorsController(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-contributors-stage]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-contributors-surface]');
    const payload = root.querySelector<HTMLScriptElement>('[data-contributors-payload]');
    const tooltip = root.querySelector<HTMLElement>('[data-contributors-tooltip]');
    const tooltipAvatar = root.querySelector<HTMLImageElement>('[data-contributors-tooltip-avatar]');
    const tooltipName = root.querySelector<HTMLElement>('[data-contributors-tooltip-name]');
    const tooltipStats = root.querySelector<HTMLElement>('[data-contributors-tooltip-stats]');
    if (!stage || !canvas || !payload || !tooltip || !tooltipAvatar || !tooltipName || !tooltipStats) {
      return () => {};
    }

    const context = canvas.getContext('2d');
    if (!context) return () => {};
    const stageElement: HTMLElement = stage;
    const canvasElement: HTMLCanvasElement = canvas;
    const renderingContext: CanvasRenderingContext2D = context;
    const tooltipElement: HTMLElement = tooltip;
    const tooltipAvatarElement: HTMLImageElement = tooltipAvatar;
    const tooltipNameElement: HTMLElement = tooltipName;
    const tooltipStatsElement: HTMLElement = tooltipStats;

    let contributors: ContributorRecord[] = [];
    try {
      contributors = JSON.parse(payload.textContent || '[]') as ContributorRecord[];
    } catch {
      root.dataset.state = 'failed';
      return () => {};
    }

    if (contributors.length === 0) {
      root.dataset.state = 'failed';
      return () => {};
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const networkInformation = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const staticMode = reducedMotion || Boolean(networkInformation?.saveData);
    const imageCache = new Map<string, CanvasImageSource>();
    const pendingImages = new Set<HTMLImageElement>();

    let width = 0;
    let height = 0;
    let particles: Particle[] = [];
    let animationFrame = 0;
    let animationStartedAt = 0;
    let animationPausedAt = 0;
    let animationComplete = staticMode;
    let resizeTimer = 0;
    let generation = 0;
    let destroyed = false;
    let ready = false;
    let inViewport = false;
    let hoveredParticle: Particle | null = null;
    let activePointer:
      | {
          id: number;
          startX: number;
          startY: number;
          particle: Particle | null;
        }
      | undefined;

    root.dataset.enhanced = 'true';
    root.dataset.state = 'loading';

    function avatarWithSize(url: string) {
      return url + (url.includes('?') ? '&' : '?') + 's=80';
    }

    function fallbackAvatar(username: string) {
      const fallback = document.createElement('canvas');
      fallback.width = 80;
      fallback.height = 80;
      const fallbackContext = fallback.getContext('2d');
      if (!fallbackContext) return fallback;

      let hash = 0;
      for (let index = 0; index < username.length; index += 1) {
        hash = (hash * 31 + username.charCodeAt(index)) >>> 0;
      }

      const shades = ['#111827', '#162033', '#1b2538', '#202b40'];
      fallbackContext.fillStyle = shades[hash % shades.length];
      fallbackContext.fillRect(0, 0, 80, 80);
      fallbackContext.strokeStyle = '#383b45';
      fallbackContext.lineWidth = 2;
      fallbackContext.strokeRect(1, 1, 78, 78);
      fallbackContext.fillStyle = '#e9e9e9';
      fallbackContext.font = '600 30px Inter, Arial, sans-serif';
      fallbackContext.textAlign = 'center';
      fallbackContext.textBaseline = 'middle';
      fallbackContext.fillText((username[0] || '?').toUpperCase(), 40, 41);
      return fallback;
    }

    function loadAvatar(contributor: ContributorRecord) {
      const cached = imageCache.get(contributor.avatar_url);
      if (cached) return Promise.resolve(cached);

      return new Promise<CanvasImageSource>((resolve) => {
        const image = new Image();
        pendingImages.add(image);
        image.decoding = 'async';
        image.onload = () => {
          pendingImages.delete(image);
          imageCache.set(contributor.avatar_url, image);
          resolve(image);
        };
        image.onerror = () => {
          pendingImages.delete(image);
          const fallback = fallbackAvatar(contributor.username);
          imageCache.set(contributor.avatar_url, fallback);
          resolve(fallback);
        };
        image.src = avatarWithSize(contributor.avatar_url);
      });
    }

    function deviceSettings() {
      if (width < 480) return { avatarSize: 19, sampleStep: 8, maxParticles: 72 };
      if (width < 900) return { avatarSize: 27, sampleStep: 6, maxParticles: 150 };
      return { avatarSize: 34, sampleStep: 5, maxParticles: 220 };
    }

    function resizeCanvas() {
      const rectangle = stageElement.getBoundingClientRect();
      width = Math.max(1, Math.round(rectangle.width));
      height = Math.max(1, Math.round(rectangle.height));
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      canvasElement.width = Math.round(width * pixelRatio);
      canvasElement.height = Math.round(height * pixelRatio);
      canvasElement.style.width = width + 'px';
      canvasElement.style.height = height + 'px';
      renderingContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    }

    function sampleTextPositions() {
      const offscreen = document.createElement('canvas');
      offscreen.width = width;
      offscreen.height = height;
      const offscreenContext = offscreen.getContext('2d', { willReadFrequently: true });
      if (!offscreenContext) return [] as Position[];

      const settings = deviceSettings();
      const fontSize = Math.min(width / 4.7, height * 0.5, 210);
      offscreenContext.font = '800 ' + fontSize + 'px Inter, Arial, sans-serif';
      offscreenContext.textAlign = 'center';
      offscreenContext.textBaseline = 'middle';
      offscreenContext.fillStyle = '#ffffff';
      offscreenContext.fillText('iFLYTEK', width / 2, height / 2);

      const pixels = offscreenContext.getImageData(0, 0, width, height).data;
      const positions: Position[] = [];
      for (let y = 0; y < height; y += settings.sampleStep) {
        for (let x = 0; x < width; x += settings.sampleStep) {
          if (pixels[(y * width + x) * 4 + 3] > 128) positions.push({ x, y });
        }
      }

      if (positions.length <= settings.maxParticles) return positions;

      const sampled: Position[] = [];
      const interval = positions.length / settings.maxParticles;
      for (let index = 0; index < settings.maxParticles; index += 1) {
        sampled.push(positions[Math.floor((index + 0.5) * interval)]);
      }
      return sampled;
    }

    async function prepareParticles(animateEntrance: boolean) {
      const currentGeneration = ++generation;
      resizeCanvas();
      const positions = sampleTextPositions();
      const contributorPool = positions.map((_, index) => contributors[index % contributors.length]);
      const requiredContributors = Array.from(
        new Map(contributorPool.map((contributor) => [contributor.avatar_url, contributor])).values()
      );
      const localImages = new Map(
        requiredContributors.map((contributor) => [
          contributor.avatar_url,
          imageCache.get(contributor.avatar_url) || fallbackAvatar(contributor.username),
        ])
      );
      const settings = deviceSettings();
      const outerRadius = Math.max(width, height) * 0.64;

      particles = positions.map((position, index) => {
        const contributor = contributorPool[index];
        const angle = index * 2.399963229728653;
        const startX = width / 2 + Math.cos(angle) * outerRadius;
        const startY = height / 2 + Math.sin(angle) * outerRadius;
        const isStatic = staticMode || !animateEntrance;

        return {
          x: isStatic ? position.x : startX,
          y: isStatic ? position.y : startY,
          targetX: position.x,
          targetY: position.y,
          startX,
          startY,
          size: settings.avatarSize,
          image: localImages.get(contributor.avatar_url) || fallbackAvatar(contributor.username),
          contributor,
          phase: (index % 17) / 17,
          progress: isStatic ? 1 : 0,
        };
      });
      hoveredParticle = null;
      activePointer = undefined;

      ready = true;
      root.dataset.state = 'ready';
      animationComplete = staticMode || !animateEntrance;
      render();

      if (!animationComplete && inViewport && !document.hidden) {
        animationStartedAt = performance.now();
        animationPausedAt = 0;
        requestAnimation();
      }

      const images = await Promise.all(requiredContributors.map((contributor) => loadAvatar(contributor)));
      if (destroyed || currentGeneration !== generation) return;

      const loadedImages = new Map(
        requiredContributors.map((contributor, index) => [contributor.avatar_url, images[index]])
      );
      particles.forEach((particle) => {
        particle.image = loadedImages.get(particle.contributor.avatar_url) || particle.image;
      });
      render();
    }

    function render() {
      renderingContext.clearRect(0, 0, width, height);

      for (const particle of particles) {
        renderingContext.globalAlpha = Math.min(1, particle.progress * 1.8);
        renderingContext.save();
        renderingContext.beginPath();
        renderingContext.arc(particle.x, particle.y, particle.size / 2, 0, Math.PI * 2);
        renderingContext.clip();
        renderingContext.drawImage(
          particle.image,
          particle.x - particle.size / 2,
          particle.y - particle.size / 2,
          particle.size,
          particle.size
        );
        renderingContext.restore();

        renderingContext.globalAlpha = 1;
        renderingContext.strokeStyle = 'rgba(1, 2, 8, 0.82)';
        renderingContext.lineWidth = 1;
        renderingContext.beginPath();
        renderingContext.arc(particle.x, particle.y, particle.size / 2, 0, Math.PI * 2);
        renderingContext.stroke();

        if (particle === hoveredParticle) {
          renderingContext.strokeStyle = '#4f9cff';
          renderingContext.lineWidth = 2;
          renderingContext.beginPath();
          renderingContext.arc(particle.x, particle.y, particle.size / 2 + 3, 0, Math.PI * 2);
          renderingContext.stroke();
        }
      }

      renderingContext.globalAlpha = 1;
    }

    function canvasPoint(clientX: number, clientY: number) {
      const rectangle = canvasElement.getBoundingClientRect();
      return {
        x: ((clientX - rectangle.left) / Math.max(1, rectangle.width)) * width,
        y: ((clientY - rectangle.top) / Math.max(1, rectangle.height)) * height,
      };
    }

    function particleAt(clientX: number, clientY: number, pointerType = 'mouse') {
      if (!ready) return null;
      const point = canvasPoint(clientX, clientY);
      let nearest: Particle | null = null;
      let nearestDistance = Number.POSITIVE_INFINITY;

      for (const particle of particles) {
        const distance = Math.hypot(point.x - particle.x, point.y - particle.y);
        const hitRadius = Math.max(particle.size / 2 + 4, pointerType === 'mouse' ? 0 : 22);
        if (distance <= hitRadius && distance < nearestDistance) {
          nearest = particle;
          nearestDistance = distance;
        }
      }

      return nearest;
    }

    function contributorStats(contributor: ContributorRecord) {
      const formatted = new Intl.NumberFormat(document.documentElement.lang === 'en' ? 'en' : 'zh-CN').format(
        contributor.contributions
      );
      return document.documentElement.lang === 'en' ? formatted + ' code commits' : formatted + ' 次代码提交';
    }

    function showTooltip(particle: Particle, clientX: number, clientY: number, refreshContent = false) {
      if (refreshContent || tooltipNameElement.textContent !== particle.contributor.username) {
        tooltipAvatarElement.src = avatarWithSize(particle.contributor.avatar_url);
        tooltipNameElement.textContent = particle.contributor.username;
        tooltipStatsElement.textContent = contributorStats(particle.contributor);
      }
      tooltipElement.hidden = false;

      const stageRectangle = stageElement.getBoundingClientRect();
      const tooltipRectangle = tooltipElement.getBoundingClientRect();
      const gap = 14;
      const localX = clientX - stageRectangle.left;
      const localY = clientY - stageRectangle.top;
      const left = Math.min(
        Math.max(gap, localX + gap),
        Math.max(gap, stageRectangle.width - tooltipRectangle.width - gap)
      );
      const preferredTop = localY - tooltipRectangle.height - gap;
      const top =
        preferredTop >= gap
          ? preferredTop
          : Math.min(localY + gap, stageRectangle.height - tooltipRectangle.height - gap);

      tooltipElement.style.transform = `translate(${Math.round(left)}px, ${Math.round(Math.max(gap, top))}px)`;
    }

    function hideTooltip() {
      tooltipElement.hidden = true;
      tooltipElement.style.removeProperty('transform');
    }

    function openContributor(particle: Particle | null) {
      if (!particle?.contributor.profile_url) return;
      window.open(particle.contributor.profile_url, '_blank', 'noopener,noreferrer');
    }

    function handlePointerMove(event: PointerEvent) {
      if (activePointer?.id === event.pointerId) {
        const movement = Math.hypot(event.clientX - activePointer.startX, event.clientY - activePointer.startY);
        if (movement > 10) activePointer.particle = null;
      }

      if (event.pointerType === 'touch') return;
      const nextParticle = particleAt(event.clientX, event.clientY, event.pointerType);
      const changed = hoveredParticle !== nextParticle;
      hoveredParticle = nextParticle;
      canvasElement.style.cursor = nextParticle ? 'pointer' : 'default';
      if (nextParticle) showTooltip(nextParticle, event.clientX, event.clientY);
      else hideTooltip();
      if (changed) render();
    }

    function handlePointerDown(event: PointerEvent) {
      activePointer = {
        id: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        particle: particleAt(event.clientX, event.clientY, event.pointerType),
      };
    }

    function handlePointerUp(event: PointerEvent) {
      if (!activePointer || activePointer.id !== event.pointerId) return;
      const movement = Math.hypot(event.clientX - activePointer.startX, event.clientY - activePointer.startY);
      const releasedParticle = particleAt(event.clientX, event.clientY, event.pointerType);
      const selectedParticle = activePointer.particle;
      activePointer = undefined;

      if (
        event.button === 0 &&
        movement <= 10 &&
        selectedParticle &&
        releasedParticle?.contributor.profile_url === selectedParticle.contributor.profile_url
      ) {
        if (event.pointerType === 'touch') hideTooltip();
        else showTooltip(selectedParticle, event.clientX, event.clientY);
        openContributor(selectedParticle);
      }
    }

    function handlePointerLeave(event: PointerEvent) {
      if (event.pointerType === 'touch') return;
      hoveredParticle = null;
      canvasElement.style.cursor = 'default';
      hideTooltip();
      render();
    }

    function handlePointerCancel() {
      activePointer = undefined;
      if (!hoveredParticle) hideTooltip();
    }

    function handleLanguageChange() {
      if (!hoveredParticle || tooltipElement.hidden) return;
      const rectangle = canvasElement.getBoundingClientRect();
      showTooltip(
        hoveredParticle,
        rectangle.left + (hoveredParticle.x / Math.max(1, width)) * rectangle.width,
        rectangle.top + (hoveredParticle.y / Math.max(1, height)) * rectangle.height,
        true
      );
    }

    function animate(timestamp: number) {
      animationFrame = 0;
      if (destroyed || !inViewport || document.hidden || animationComplete) return;

      const elapsed = timestamp - animationStartedAt;
      let complete = true;

      particles.forEach((particle, index) => {
        const delay = (index / Math.max(1, particles.length)) * 420;
        const progress = Math.max(0, Math.min(1, (elapsed - delay) / 1350));
        const eased = 1 - Math.pow(1 - progress, 3);
        particle.progress = progress;
        particle.x = particle.startX + (particle.targetX - particle.startX) * eased;
        particle.y = particle.startY + (particle.targetY - particle.startY) * eased;
        if (progress < 1) complete = false;
      });

      render();
      animationComplete = complete;
      if (!complete) requestAnimation();
    }

    function requestAnimation() {
      if (!animationFrame) animationFrame = window.requestAnimationFrame(animate);
    }

    function cancelAnimation() {
      if (!animationFrame) return;
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
    }

    function pauseAnimation() {
      if (!animationComplete && animationStartedAt > 0 && animationPausedAt === 0) {
        animationPausedAt = performance.now();
      }
      cancelAnimation();
    }

    function resumeAnimation() {
      if (animationComplete || !ready || !inViewport || document.hidden) return;
      const resumedAt = performance.now();
      if (animationStartedAt === 0) {
        animationStartedAt = resumedAt;
      } else if (animationPausedAt > 0) {
        animationStartedAt += resumedAt - animationPausedAt;
        animationPausedAt = 0;
      }
      requestAnimation();
    }

    function handleVisibilityChange() {
      if (document.hidden) {
        pauseAnimation();
      } else {
        resumeAnimation();
      }
    }

    const intersectionObserver = new IntersectionObserver(
      (entries) => {
        inViewport = entries.some((entry) => entry.isIntersecting);
        if (!inViewport) {
          pauseAnimation();
          return;
        }

        if (!ready) {
          void prepareParticles(true);
        } else {
          resumeAnimation();
        }
      },
      { rootMargin: '120px 0px', threshold: 0.05 }
    );

    const resizeObserver = new ResizeObserver(() => {
      const rectangle = stageElement.getBoundingClientRect();
      if (Math.round(rectangle.width) === width && Math.round(rectangle.height) === height) return;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (destroyed || !ready) return;
        cancelAnimation();
        void prepareParticles(false);
      }, 160);
    });

    document.addEventListener('visibilitychange', handleVisibilityChange);
    document.addEventListener('languagechange', handleLanguageChange);
    canvasElement.addEventListener('pointermove', handlePointerMove);
    canvasElement.addEventListener('pointerdown', handlePointerDown);
    canvasElement.addEventListener('pointerup', handlePointerUp);
    canvasElement.addEventListener('pointerleave', handlePointerLeave);
    canvasElement.addEventListener('pointercancel', handlePointerCancel);
    intersectionObserver.observe(stageElement);
    resizeObserver.observe(stageElement);
    resizeCanvas();

    return () => {
      destroyed = true;
      generation += 1;
      pauseAnimation();
      pendingImages.forEach((image) => {
        image.onload = null;
        image.onerror = null;
        image.removeAttribute('src');
      });
      pendingImages.clear();
      window.clearTimeout(resizeTimer);
      intersectionObserver.disconnect();
      resizeObserver.disconnect();
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      document.removeEventListener('languagechange', handleLanguageChange);
      canvasElement.removeEventListener('pointermove', handlePointerMove);
      canvasElement.removeEventListener('pointerdown', handlePointerDown);
      canvasElement.removeEventListener('pointerup', handlePointerUp);
      canvasElement.removeEventListener('pointerleave', handlePointerLeave);
      canvasElement.removeEventListener('pointercancel', handlePointerCancel);
    };
  }

  if (!window.__iflytekContributorsCanvasRuntime) {
    const controllers = new Map<HTMLElement, () => void>();
    const runtime: CanvasRuntime = {
      mountAll() {
        document.querySelectorAll<HTMLElement>('[data-contributors-canvas]').forEach((root) => {
          if (!controllers.has(root)) controllers.set(root, createContributorsController(root));
        });
      },
      destroyAll() {
        controllers.forEach((destroy) => destroy());
        controllers.clear();
      },
    };

    window.__iflytekContributorsCanvasRuntime = runtime;
    document.addEventListener('astro:page-load', runtime.mountAll);
    document.addEventListener('astro:before-swap', runtime.destroyAll);
  }

  window.__iflytekContributorsCanvasRuntime.mountAll();
</script>

<style>
  .contributors-field {
    overflow: hidden;
    border: 1px solid var(--rc-rule-strong);
    border-radius: var(--rc-radius-surface);
    background: #05070d;
  }

  .contributors-field__header,
  .contributors-field__caption {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.055em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .contributors-field__header {
    border-bottom: 1px solid var(--rc-rule);
  }

  .contributors-field__stage {
    position: relative;
    height: clamp(20rem, 38vw, 31rem);
    overflow: hidden;
    background-color: #05070d;
    background-image:
      linear-gradient(var(--rc-rule) 1px, transparent 1px), linear-gradient(90deg, var(--rc-rule) 1px, transparent 1px);
    background-position: center;
    background-size: 4rem 4rem;
    isolation: isolate;
  }

  .contributors-field__stage::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 2%);
    content: '';
    pointer-events: none;
  }

  .contributors-field canvas {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    touch-action: pan-y;
    transition: opacity 240ms ease;
  }

  .contributors-field[data-state='ready'] canvas {
    opacity: 1;
    pointer-events: auto;
  }

  .contributors-field__tooltip {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    display: flex;
    width: max-content;
    max-width: min(15rem, calc(100% - 1.75rem));
    align-items: center;
    gap: 0.7rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--rc-rule-strong);
    border-radius: var(--rc-radius-control);
    background: rgb(5 7 13 / 96%);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 28%);
    color: var(--rc-text-strong);
