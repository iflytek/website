---
import hfIcon from '~/assets/images/hugging-face.svg';

interface Props {
  slug: string;
  name: string;
  nameEn?: string;
  description: string;
  descriptionEn?: string;
  repo: string;
  homepage?: string;
  categoryLabelZh: string;
  categoryLabelEn: string;
  languages?: string[];
  featured?: boolean;
  stars?: number;
  forks?: number;
  license?: string;
  icon?: string;
  links?: string[];
}

const {
  slug,
  name,
  nameEn,
  description,
  descriptionEn,
  repo,
  homepage,
  categoryLabelZh,
  categoryLabelEn,
  languages = [],
  featured = false,
  stars,
  forks,
  license,
  icon,
  links = [],
} = Astro.props;

const projectInitials = name
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .join('')
  .slice(0, 2)
  .toUpperCase();

const formatNumber = (value: number) => {
  if (value >= 1000) return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`;
  return value.toLocaleString('en-US');
};

const resources = [
  ...(homepage ? [{ href: homepage, labelZh: '官网', labelEn: 'Website', kind: 'website' }] : []),
  ...links.map((href) => {
    const isHuggingFace = href.includes('huggingface');
    const isModelScope = href.includes('modelscope');
    return {
      href,
      labelZh: isHuggingFace ? 'Hugging Face' : isModelScope ? 'ModelScope' : '资源',
      labelEn: isHuggingFace ? 'Hugging Face' : isModelScope ? 'ModelScope' : 'Resource',
      kind: isHuggingFace ? 'huggingface' : isModelScope ? 'modelscope' : 'resource',
    };
  }),
];
---

<article class="project-entry">
  <header class="project-entry__header">
    <div class:list={['project-entry__icon', featured && 'is-featured']}>
      {
        icon ? (
          <img src={icon} alt="" loading="lazy" decoding="async" />
        ) : (
          <span aria-hidden="true">{projectInitials}</span>
        )
      }
    </div>

    <div class="project-entry__identity">
      <h3>
        <a href={`/projects/${slug}`}>
          <span data-lang-zh={name} data-lang-en={nameEn || name}>{name}</span>
        </a>
      </h3>
      <div class="project-entry__classification">
        <span data-lang-zh={categoryLabelZh} data-lang-en={categoryLabelEn}>{categoryLabelZh}</span>
        {
          featured && (
            <>
              <span class="project-entry__separator" aria-hidden="true">
                ·
              </span>
              <span data-lang-zh="精选" data-lang-en="Featured">
                精选
              </span>
            </>
          )
        }
      </div>
    </div>

    <a class="project-entry__detail" href={`/projects/${slug}`}>
      <span data-lang-zh="查看详情" data-lang-en="View details">查看详情</span>
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4.5 10h10m-3.5-3.5 3.5 3.5-3.5 3.5"></path>
      </svg>
    </a>
  </header>

  <p class="project-entry__description" data-lang-zh={description} data-lang-en={descriptionEn || description}>
    {description}
  </p>

  <footer class="project-entry__footer">
    <div class="project-entry__metadata">
      {
        languages.length > 0 && (
          <span class="project-entry__languages">
            <span class="project-entry__signal" aria-hidden="true" />
            {languages.join(' · ')}
          </span>
        )
      }
      {
        typeof stars === 'number' && (
          <span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="m10 2.8 2.1 4.3 4.7.7-3.4 3.3.8 4.7-4.2-2.2-4.2 2.2.8-4.7-3.4-3.3 4.7-.7L10 2.8Z" />
            </svg>
            <span>{formatNumber(stars)}</span>
            <span
              class="sr-only"
              data-lang-zh={`${name} 的 GitHub Stars`}
              data-lang-en={`${nameEn || name} GitHub Stars`}
            >
              {name} 的 GitHub Stars
            </span>
          </span>
        )
      }
      {
        typeof forks === 'number' && (
          <a href={`https://github.com/${repo}/network/members`} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M6 3.25v2.5M14 3.25v2.5M6 5.75h8M10 5.75v6M7 14.75h6M10 11.75v3" />
              <circle cx="6" cy="3.25" r="1.5" />
              <circle cx="14" cy="3.25" r="1.5" />
              <circle cx="10" cy="15.75" r="1.5" />
            </svg>
            <span>{formatNumber(forks)}</span>
            <span
              class="sr-only"
              data-lang-zh={`${name} 的 GitHub Forks（在新标签页打开）`}
              data-lang-en={`${nameEn || name} GitHub Forks (opens in a new tab)`}
            >
              {name} 的 GitHub Forks（在新标签页打开）
            </span>
          </a>
        )
      }
      {license && <span>{license}</span>}
    </div>

    <nav class="project-entry__resources" aria-labelledby={`project-resources-${slug}`}>
      <span
        id={`project-resources-${slug}`}
        class="sr-only"
        data-lang-zh={`${name} 资源`}
        data-lang-en={`${nameEn || name} resources`}>{name} 资源</span
      >
      <a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            stroke="none"
            d="M12 .9a11.1 11.1 0 0 0-3.5 21.7c.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2V22c0 .3.2.7.8.6A11.1 11.1 0 0 0 12 .9Z"
          ></path>
        </svg>
        <span>GitHub</span>
        <span class="sr-only" data-lang-zh="（在新标签页打开）" data-lang-en="(opens in a new tab)"
          >（在新标签页打开）</span
        >
      </a>

      {
        resources.map((resource) => (
          <a href={resource.href} target="_blank" rel="noopener noreferrer">
            {resource.kind === 'huggingface' ? (
              <img src={hfIcon.src} alt="" aria-hidden="true" />
            ) : resource.kind === 'modelscope' ? (
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="7" />
                <circle cx="10" cy="10" r="3" />
              </svg>
            ) : (
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M7.5 4.5h8v8M15.5 4.5l-9 9" />
              </svg>
            )}
            <span data-lang-zh={resource.labelZh} data-lang-en={resource.labelEn}>
              {resource.labelZh}
            </span>
            <span class="sr-only" data-lang-zh="（在新标签页打开）" data-lang-en="(opens in a new tab)">
              （在新标签页打开）
            </span>
          </a>
        ))
      }
    </nav>
  </footer>
</article>

<style>
  .project-entry {
    position: relative;
    display: flex;
    height: 100%;
    min-height: 14rem;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--rc-rule);
    border-radius: var(--rc-radius-surface);
    background: rgb(5 7 13 / 72%);
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .project-entry:hover,
  .project-entry:focus-within {
    border-color: var(--rc-rule-strong);
    background: var(--rc-band);
  }

  .project-entry__header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.875rem;
    align-items: start;
  }

  .project-entry__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--rc-rule-strong);
    border-radius: var(--rc-radius-control);
    background: var(--rc-surface);
    color: var(--rc-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .project-entry__icon.is-featured {
    border-color: rgb(60 143 247 / 62%);
  }

  .project-entry__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-entry__identity {
    min-width: 0;
  }

  .project-entry__classification {
    display: flex;
    min-height: 1rem;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin-top: 0.15rem;
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .project-entry__separator {
    color: var(--rc-blue);
  }

  .project-entry h3 {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    margin: 0;
    font-size: clamp(1.18rem, 1.7vw, 1.45rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .project-entry h3 a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--rc-text-strong);
    text-decoration: none;
  }

  .project-entry h3 a:hover {
    color: #ffffff;
  }

  .project-entry__detail {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0 0.875rem;
    border: 1px solid var(--rc-rule-strong);
    border-radius: var(--rc-radius-control);
    background: var(--rc-surface-raised);
    color: var(--rc-text);
    font-size: 0.8125rem;
    font-weight: 580;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .project-entry__detail:hover {
    border-color: var(--rc-header-rule);
    background: var(--rc-band);
    color: #ffffff;
  }

  .project-entry__detail svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 160ms ease;
  }

  .project-entry__detail:hover svg {
    transform: translateX(0.125rem);
  }

  .project-entry__description {
    max-width: 68ch;
    flex: 1;
    margin: 1rem 0 0.75rem;
    color: var(--rc-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .project-entry__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.625rem;
    border-top: 1px solid var(--rc-rule);
  }

  .project-entry__metadata,
  .project-entry__resources {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    align-items: center;
  }

  .project-entry__metadata {
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .project-entry__metadata > span,
  .project-entry__metadata > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.35rem;
  }

  .project-entry__metadata > a {
    min-width: 2.75rem;
    justify-content: center;
    color: var(--rc-text-muted);
    text-decoration: none;
  }

  .project-entry__metadata > a:hover {
    color: var(--rc-text);
  }

  .project-entry__metadata svg {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
  }

  .project-entry__languages {
    white-space: nowrap;
  }

  .project-entry__signal {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--rc-blue);
    box-shadow: 0 0 0.75rem rgb(60 143 247 / 45%);
  }

  .project-entry__resources {
    justify-content: flex-end;
  }

  .project-entry__resources a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.38rem;
    color: var(--rc-text-muted);
    font-size: 0.8125rem;
    font-weight: 520;
    text-decoration: underline;
    text-decoration-color: rgb(160 159 162 / 35%);
    text-underline-offset: 0.28em;
  }

  .project-entry__resources a:hover {
    color: var(--rc-text);
    text-decoration-color: var(--rc-blue);
  }

  .project-entry__resources svg,
  .project-entry__resources img {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .project-entry__resources svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  :where(.project-entry a):focus-visible {
    border-radius: var(--rc-radius-control);
    outline: 2px solid var(--rc-focus);
    outline-offset: 3px;
  }

  @media (max-width: 64rem) {
    .project-entry {
      min-height: auto;
    }
  }

  @media (max-width: 42rem) {
    .project-entry {
      min-height: auto;
      padding: 1.125rem;
    }

    .project-entry__header {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .project-entry__detail {
      grid-column: 1 / -1;
      justify-self: stretch;
      margin-top: 0.25rem;
    }

    .project-entry__description {
      margin-top: 1.25rem;
    }

    .project-entry__footer {
      align-items: flex-start;
    }

    .project-entry__resources {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-entry,
    .project-entry__detail,
    .project-entry__detail svg {
      transition: none;
    }

    .project-entry__detail:hover svg {
      transform: none;
    }
  }
</style>
