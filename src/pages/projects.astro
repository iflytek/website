---
import Layout from '~/layouts/PageLayout.astro';
import ProjectCard from '~/components/projects/ProjectCard.astro';
import { getProjectsWithStats } from '~/utils/project-stats';

export const prerender = true;

const metadata = {
  title: 'Projects',
  description: '探索 Astron 企业级 Agentic AI 开源生态中的项目、工具与能力。',
};

const projects = await getProjectsWithStats();
const sortedProjects = [...projects].sort((a, b) => (b.data.stars || 0) - (a.data.stars || 0));

const categoryLabels: Record<string, { zh: string; en: string }> = {
  'agentic-workflow': { zh: '智能体工作流', en: 'Agentic workflow' },
  'agentic-automation': { zh: '智能体自动化', en: 'Agentic automation' },
  'agent-skills': { zh: '智能体技能', en: 'Agent skills' },
  tutorial: { zh: '教程指南', en: 'Tutorial' },
  'agent-management': { zh: '智能体管理', en: 'Agent management' },
  'agent-engine': { zh: '智能体引擎', en: 'Agent engine' },
  'memory-system': { zh: '记忆系统', en: 'Memory system' },
  llm: { zh: '大语言模型', en: 'LLM' },
};

const categoryOrder = Object.keys(categoryLabels);
const presentCategories = new Set(sortedProjects.map((project) => project.data.category));
const categories = categoryOrder.filter((category) => presentCategories.has(category));
const languages = [...new Set(sortedProjects.flatMap((project) => project.data.languages || []))].sort();

const totalStars = sortedProjects.reduce((sum, project) => sum + (project.data.stars || 0), 0);
const totalForks = sortedProjects.reduce((sum, project) => sum + (project.data.forks || 0), 0);
const hasCompleteStarTotals = sortedProjects.every((project) => typeof project.data.stars === 'number');
const hasCompleteForkTotals = sortedProjects.every((project) => typeof project.data.forks === 'number');
const featuredCount = sortedProjects.filter((project) => project.data.featured).length;

const formatCompactNumber = (value: number) => {
  if (value >= 1000) return `${(value / 1000).toFixed(1).replace(/\.0$/, '')}k`;
  return value.toLocaleString('en-US');
};
---

<Layout metadata={metadata}>
  <section class="projects-directory" data-projects-directory>
    <div class="projects-directory__shell">
      <form class="directory-control-deck" data-filter-form novalidate hidden>
        <fieldset class="directory-scope" data-scope-group>
          <legend class="sr-only" data-lang-zh="项目范围" data-lang-en="Project scope">项目范围</legend>
          <button type="button" data-scope="all" aria-pressed="true">
            <span data-lang-zh="全部项目" data-lang-en="All projects">全部项目</span>
            <span class="directory-scope__count">{sortedProjects.length}</span>
          </button>
          <button type="button" data-scope="featured" aria-pressed="false">
            <span data-lang-zh="精选项目" data-lang-en="Featured">精选项目</span>
            <span class="directory-scope__count">{featuredCount}</span>
          </button>
        </fieldset>

        <div class="directory-tools">
          <div class="directory-select" data-select-control="category">
            <span id="category-filter-label" class="directory-control-label" data-lang-zh="类别" data-lang-en="Category"
              >类别</span
            >
            <select data-category-filter hidden>
              <option value="all" data-lang-zh="全部类别" data-lang-en="All categories">全部类别</option>
              {
                categories.map((category) => (
                  <option
                    value={category}
                    data-lang-zh={categoryLabels[category]?.zh || category}
                    data-lang-en={categoryLabels[category]?.en || category}
                  >
                    {categoryLabels[category]?.zh || category}
                  </option>
                ))
              }
            </select>
            <button
              class="directory-select__trigger"
              type="button"
              role="combobox"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="category-filter-listbox"
              aria-labelledby="category-filter-label category-filter-value"
              data-select-trigger
            >
              <span id="category-filter-value" class="directory-select__value" data-select-value>全部类别</span>
              <span class="directory-select__chevron" aria-hidden="true"></span>
            </button>
            <div
              id="category-filter-listbox"
              class="directory-select__menu"
              role="listbox"
              aria-labelledby="category-filter-label"
              data-select-list
              hidden
            >
              <div
                id="category-filter-option-0"
                class="directory-select__option"
                role="option"
                aria-selected="true"
                data-select-option
                data-value="all"
                data-lang-zh="全部类别"
                data-lang-en="All categories"
              >
                全部类别
              </div>
              {
                categories.map((category, index) => (
                  <div
                    id={`category-filter-option-${index + 1}`}
                    class="directory-select__option"
                    role="option"
                    aria-selected="false"
                    data-select-option
                    data-value={category}
                    data-lang-zh={categoryLabels[category]?.zh || category}
                    data-lang-en={categoryLabels[category]?.en || category}
                  >
                    {categoryLabels[category]?.zh || category}
                  </div>
                ))
              }
            </div>
          </div>

          <div class="directory-select" data-select-control="language" data-select-align="end">
            <span id="language-filter-label" class="directory-control-label" data-lang-zh="语言" data-lang-en="Language"
              >语言</span
            >
            <select data-language-filter hidden>
              <option value="all" data-lang-zh="全部语言" data-lang-en="All languages">全部语言</option>
              {languages.map((language) => <option value={language}>{language}</option>)}
            </select>
            <button
              class="directory-select__trigger"
              type="button"
              role="combobox"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="language-filter-listbox"
              aria-labelledby="language-filter-label language-filter-value"
              data-select-trigger
            >
              <span id="language-filter-value" class="directory-select__value" data-select-value>全部语言</span>
              <span class="directory-select__chevron" aria-hidden="true"></span>
            </button>
            <div
              id="language-filter-listbox"
              class="directory-select__menu"
              role="listbox"
              aria-labelledby="language-filter-label"
              data-select-list
              hidden
            >
              <div
                id="language-filter-option-0"
                class="directory-select__option"
                role="option"
                aria-selected="true"
                data-select-option
                data-value="all"
                data-lang-zh="全部语言"
                data-lang-en="All languages"
              >
                全部语言
              </div>
              {
                languages.map((language, index) => (
                  <div
                    id={`language-filter-option-${index + 1}`}
                    class="directory-select__option"
                    role="option"
                    aria-selected="false"
                    data-select-option
                    data-value={language}
                  >
                    {language}
                  </div>
                ))
              }
            </div>
          </div>

          <label class="directory-search">
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.25"></circle>
              <path d="m12.5 12.5 4 4"></path>
            </svg>
            <span class="sr-only" data-lang-zh="搜索项目" data-lang-en="Search projects">搜索项目</span>
            <input
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="搜索项目…"
              data-placeholder-zh="搜索项目…"
              data-placeholder-en="Search projects…"
              data-search-filter
            />
          </label>
        </div>
      </form>

      <header class="directory-intro">
        <h1 data-lang-zh="开源项目" data-lang-en="Projects">开源项目</h1>
        <p
          data-lang-zh="探索 Astron 企业级 Agentic AI 开源生态，快速找到适合使用、集成或贡献的项目。"
          data-lang-en="Explore the Astron enterprise Agentic AI ecosystem and find the right project to use, integrate, or contribute to."
        >
          探索 Astron 企业级 Agentic AI 开源生态，快速找到适合使用、集成或贡献的项目。
        </p>
        <span id="project-statistics-label" class="sr-only" data-lang-zh="项目统计" data-lang-en="Project statistics"
          >项目统计</span
        >
        <div class="directory-proof" aria-labelledby="project-statistics-label">
          <span
            ><strong>{sortedProjects.length}</strong>
            <span data-lang-zh="个项目" data-lang-en="projects">个项目</span></span
          >
          {
            hasCompleteStarTotals && (
              <span>
                <strong>{formatCompactNumber(totalStars)}</strong> GitHub Stars
              </span>
            )
          }
          {
            hasCompleteForkTotals && (
              <span>
                <strong>{formatCompactNumber(totalForks)}</strong> Forks
              </span>
            )
          }
          <span>Apache 2.0</span>
        </div>
      </header>

      <div class="directory-status">
        <p data-result-count data-template-zh="显示 {count} 个项目" data-template-en="Showing {count} projects">
          显示 {sortedProjects.length} 个项目
        </p>
        <div class="directory-status__actions">
          <span data-lang-zh="按 GitHub Stars 排序" data-lang-en="Sorted by GitHub Stars">按 GitHub Stars 排序</span>
          <button type="button" data-clear-filters hidden>
            <span data-lang-zh="清除筛选" data-lang-en="Clear filters">清除筛选</span>
          </button>
        </div>
      </div>

      <section class="directory-results" aria-labelledby="project-list-title">
        <h2 id="project-list-title" class="sr-only" data-lang-zh="项目目录" data-lang-en="Project directory">
          项目目录
        </h2>

        <div class="project-grid" data-project-grid>
          {
            sortedProjects.map((project) => {
              const slug = project.id.replace(/\.ya?ml$/, '');
              const categoryLabel = categoryLabels[project.data.category] || {
                zh: project.data.category,
                en: project.data.category,
              };
              const searchableText = [
                project.data.name,
                project.data.nameEn,
                project.data.description,
                project.data.descriptionEn,
                project.data.repo,
                categoryLabel.zh,
                categoryLabel.en,
                ...(project.data.languages || []),
                ...(project.data.tags || []),
              ]
                .filter(Boolean)
                .join(' ')
                .normalize('NFKC')
                .toLocaleLowerCase();

              return (
                <div
                  class="project-item"
                  data-project-item
                  data-category={project.data.category}
                  data-languages={(project.data.languages || []).join(',')}
                  data-featured={String(Boolean(project.data.featured))}
                  data-search={searchableText}
                >
                  <ProjectCard
                    slug={slug}
                    name={project.data.name}
                    nameEn={project.data.nameEn}
                    description={project.data.description}
                    descriptionEn={project.data.descriptionEn}
                    repo={project.data.repo}
                    homepage={project.data.homepage}
                    categoryLabelZh={categoryLabel.zh}
                    categoryLabelEn={categoryLabel.en}
                    languages={project.data.languages}
                    featured={project.data.featured}
                    stars={project.data.stars}
                    forks={project.data.forks}
                    license={project.data.license}
                    icon={project.data.icon}
                    links={project.data.links}
                  />
                </div>
              );
            })
          }
        </div>

        <div class="directory-empty" data-empty-state hidden>
          <div class="directory-empty__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="10.5" cy="10.5" r="6.5"></circle>
              <path d="m15.5 15.5 5 5M8 10.5h5"></path>
            </svg>
          </div>
          <p class="directory-empty__title" data-lang-zh="没有匹配的项目" data-lang-en="No matching projects">
            没有匹配的项目
          </p>
          <p
            data-lang-zh="换一个关键词或清除筛选，即可重新浏览全部项目。"
            data-lang-en="Try another term or clear the filters to browse every project."
          >
            换一个关键词或清除筛选，即可重新浏览全部项目。
          </p>
          <button type="button" data-clear-filters>
            <span data-lang-zh="清除筛选" data-lang-en="Clear filters">清除筛选</span>
          </button>
        </div>

        <p class="sr-only" aria-live="polite" aria-atomic="true" data-result-live></p>
      </section>

      <a class="directory-landscape" href="/#project-landscape">
        <span>
          <strong data-lang-zh="查看 Astron 项目全景图" data-lang-en="View the Astron project landscape"
            >查看 Astron 项目全景图</strong
          >
          <span
            data-lang-zh="了解项目在企业级 Agentic AI 生态中的位置"
            data-lang-en="See where each project sits in the enterprise Agentic AI ecosystem"
            >了解项目在企业级 Agentic AI 生态中的位置</span
          >
        </span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10h10m-3.5-3.5 3.5 3.5-3.5 3.5"></path></svg>
      </a>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
      const root = document.querySelector('[data-projects-directory]');
      if (!root || root.dataset.directoryReady === 'true') return;
      root.dataset.directoryReady = 'true';

      const form = root.querySelector('[data-filter-form]');
      const scopeButtons = Array.from(root.querySelectorAll('[data-scope]'));
      const categorySelect = root.querySelector('[data-category-filter]');
      const languageSelect = root.querySelector('[data-language-filter]');
      const searchInput = root.querySelector('[data-search-filter]');
      const projectItems = Array.from(root.querySelectorAll('[data-project-item]'));
      const resultCount = root.querySelector('[data-result-count]');
      const resultLive = root.querySelector('[data-result-live]');
      const emptyState = root.querySelector('[data-empty-state]');
      const clearButtons = Array.from(root.querySelectorAll('[data-clear-filters]'));

      if (!form || !categorySelect || !languageSelect || !searchInput) return;

      const validScopes = new Set(scopeButtons.map((button) => button.dataset.scope));
      const validCategories = new Set(Array.from(categorySelect.options).map((option) => option.value));
      const validLanguages = new Set(Array.from(languageSelect.options).map((option) => option.value));
      const initialUrl = new URL(window.location.href);
      const requestedScope = initialUrl.searchParams.get('scope') || 'all';
      const requestedCategory = initialUrl.searchParams.get('category') || 'all';
      const requestedLanguage = initialUrl.searchParams.get('language') || 'all';
      let activeScope = validScopes.has(requestedScope) ? requestedScope : 'all';

      categorySelect.value = validCategories.has(requestedCategory) ? requestedCategory : 'all';
      languageSelect.value = validLanguages.has(requestedLanguage) ? requestedLanguage : 'all';
      searchInput.value = initialUrl.searchParams.get('q') || '';

      const normalize = (value) => value.normalize('NFKC').toLocaleLowerCase().trim();
      const currentLanguage = () => (localStorage.lang === 'en' ? 'en' : 'zh');

      function createSelectController(control) {
        const nativeSelect = control.querySelector('select');
        const trigger = control.querySelector('[data-select-trigger]');
        const valueLabel = control.querySelector('[data-select-value]');
        const listbox = control.querySelector('[data-select-list]');
        const options = Array.from(control.querySelectorAll('[data-select-option]'));

        if (!nativeSelect || !trigger || !valueLabel || !listbox || options.length === 0) return null;

        let activeIndex = 0;
        let typeahead = '';
        let typeaheadTimer;

        const selectedIndex = () =>
          Math.max(
            0,
            options.findIndex((option) => option.dataset.value === nativeSelect.value)
          );
        const localizedLabel = (option) => {
          const nativeOption = Array.from(nativeSelect.options).find(
            (candidate) => candidate.value === option.dataset.value
          );
          if (!nativeOption) return option.textContent?.trim() || '';
          const localized = currentLanguage() === 'en' ? nativeOption.dataset.langEn : nativeOption.dataset.langZh;
          return localized || nativeOption.textContent?.trim() || '';
        };

        function clearTypeahead() {
          window.clearTimeout(typeaheadTimer);
          typeahead = '';
        }

        function positionListbox() {
          const visualViewport = window.visualViewport;
          const viewportTop = visualViewport?.offsetTop || 0;
          const viewportBottom = viewportTop + (visualViewport?.height || window.innerHeight);
          const triggerRect = trigger.getBoundingClientRect();
          const edgeClearance = 12;
          const menuGap = 8;
          const spaceBelow = Math.max(0, viewportBottom - triggerRect.bottom - menuGap - edgeClearance);
          const spaceAbove = Math.max(0, triggerRect.top - viewportTop - menuGap - edgeClearance);
          const desiredHeight = Math.min(listbox.scrollHeight, 352);
          const openAbove = spaceBelow < desiredHeight && spaceAbove > spaceBelow;
          const availableHeight = openAbove ? spaceAbove : spaceBelow;

          control.dataset.selectPlacement = openAbove ? 'top' : 'bottom';
          listbox.style.setProperty('--directory-menu-available', `${Math.floor(availableHeight)}px`);
        }

        function setActive(index) {
          activeIndex = Math.min(Math.max(index, 0), options.length - 1);
          options.forEach((option, optionIndex) => {
            option.toggleAttribute('data-active', optionIndex === activeIndex);
          });
          trigger.setAttribute('aria-activedescendant', options[activeIndex].id);
          options[activeIndex].scrollIntoView({ block: 'nearest' });
        }

        function sync() {
          const index = selectedIndex();
          valueLabel.textContent = localizedLabel(options[index]);
          options.forEach((option, optionIndex) => {
            option.setAttribute('aria-selected', String(optionIndex === index));
          });
          if (trigger.getAttribute('aria-expanded') === 'true') setActive(index);
        }

        function close({ restoreFocus = false } = {}) {
          clearTypeahead();
          listbox.hidden = true;
          control.dataset.open = 'false';
          trigger.setAttribute('aria-expanded', 'false');
          trigger.removeAttribute('aria-activedescendant');
          options.forEach((option) => option.removeAttribute('data-active'));
          if (restoreFocus) trigger.focus({ preventScroll: true });
        }

        function open(index = selectedIndex()) {
          selectControllers.forEach((controller) => {
            if (controller && controller.control !== control) controller.close();
          });
          listbox.hidden = false;
          control.dataset.open = 'true';
          trigger.setAttribute('aria-expanded', 'true');
          positionListbox();
          setActive(index);
          trigger.focus({ preventScroll: true });
        }

        function reposition() {
          if (trigger.getAttribute('aria-expanded') !== 'true') return;
          positionListbox();
          setActive(activeIndex);
        }

        function commit(index) {
          const option = options[index];
          if (!option) return;
          nativeSelect.value = option.dataset.value || 'all';
          sync();
          nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
          close({ restoreFocus: true });
        }

        trigger.addEventListener('click', () => {
          if (trigger.getAttribute('aria-expanded') === 'true') close({ restoreFocus: true });
          else open();
        });

        trigger.addEventListener('keydown', (event) => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';

          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            if (!isOpen) {
              open();
              return;
            }
            const direction = event.key === 'ArrowDown' ? 1 : -1;
            setActive((activeIndex + direction + options.length) % options.length);
            return;
          }

          if (event.key === 'Home' || event.key === 'End') {
            event.preventDefault();
            if (!isOpen) open(event.key === 'Home' ? 0 : options.length - 1);
            else setActive(event.key === 'Home' ? 0 : options.length - 1);
            return;
          }

          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            if (isOpen) commit(activeIndex);
            else open();
            return;
          }

          if (event.key === 'Escape' && isOpen) {
            event.preventDefault();
            close({ restoreFocus: true });
            return;
          }

          if (event.key === 'Tab' && isOpen) {
            event.preventDefault();
            close();
            const focusableControls = Array.from(
              form.querySelectorAll('[data-scope], [data-select-trigger], [data-search-filter]')
            );
            const currentIndex = focusableControls.indexOf(trigger);
            const nextIndex = currentIndex + (event.shiftKey ? -1 : 1);
            focusableControls[nextIndex]?.focus();
            return;
          }

          if (isOpen && event.key.length === 1 && !event.metaKey && !event.ctrlKey && !event.altKey) {
            const typedCharacter = normalize(event.key);
            if (!typedCharacter) return;

            const previousRunRepeats =
              typeahead.length > 0 && Array.from(typeahead).every((character) => character === typeahead[0]);
            const cycleByInitial = previousRunRepeats && typedCharacter === typeahead[0];

            if (previousRunRepeats && typedCharacter !== typeahead[0]) {
              typeahead = `${typeahead[0]}${typedCharacter}`;
            } else {
              typeahead += typedCharacter;
            }

            window.clearTimeout(typeaheadTimer);
            typeaheadTimer = window.setTimeout(() => {
              typeahead = '';
            }, 600);

            const query = cycleByInitial ? typedCharacter : typeahead;
            const startIndex = cycleByInitial ? (activeIndex + 1) % options.length : 0;
            const matchIndex = Array.from(
              { length: options.length },
              (_, offset) => (startIndex + offset) % options.length
            ).find((index) => normalize(localizedLabel(options[index])).startsWith(query));
            if (matchIndex >= 0) setActive(matchIndex);
          }
        });

        options.forEach((option, index) => {
          option.addEventListener('pointermove', () => setActive(index));
          option.addEventListener('pointerdown', (event) => event.preventDefault());
          option.addEventListener('click', () => commit(index));
        });

        sync();
        return { control, close, reposition, sync };
      }

      const selectControllers = Array.from(root.querySelectorAll('[data-select-control]'))
        .map(createSelectController)
        .filter(Boolean);

      const syncSelectControls = () => selectControllers.forEach((controller) => controller.sync());

      function localizedResult(count) {
        if (currentLanguage() !== 'en') return `显示 ${count} 个项目`;
        return count === 1 ? 'Showing 1 project' : `Showing ${count} projects`;
      }

      function syncUrl() {
        const url = new URL(window.location.href);
        const query = searchInput.value.trim();
        const values = {
          scope: activeScope,
          category: categorySelect.value,
          language: languageSelect.value,
          q: query,
        };

        Object.entries(values).forEach(([key, value]) => {
          const isDefault = key === 'q' ? !value : value === 'all';
          if (isDefault) url.searchParams.delete(key);
          else url.searchParams.set(key, value);
        });
        window.history.replaceState(window.history.state, '', url);
      }

      function applyFilters({ announce = true, sync = true } = {}) {
        const category = categorySelect.value;
        const language = languageSelect.value;
        const query = normalize(searchInput.value);
        let visibleCount = 0;

        projectItems.forEach((item) => {
          const languages = (item.dataset.languages || '').split(',').filter(Boolean);
          const matchesScope = activeScope === 'all' || item.dataset.featured === 'true';
          const matchesCategory = category === 'all' || item.dataset.category === category;
          const matchesLanguage = language === 'all' || languages.includes(language);
          const matchesSearch = !query || normalize(item.dataset.search || '').includes(query);
          const isVisible = matchesScope && matchesCategory && matchesLanguage && matchesSearch;
          item.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        scopeButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.scope === activeScope));
        });

        const hasFilters = activeScope !== 'all' || category !== 'all' || language !== 'all' || Boolean(query);
        clearButtons.forEach((button) => {
          button.hidden = !hasFilters && button.closest('[data-empty-state]') === null;
        });
        emptyState.hidden = visibleCount !== 0;

        const resultText = localizedResult(visibleCount);
        resultCount.textContent = resultText;
        if (announce) resultLive.textContent = resultText;
        if (sync) syncUrl();
      }

      function clearFilters() {
        activeScope = 'all';
        categorySelect.value = 'all';
        languageSelect.value = 'all';
        searchInput.value = '';
        syncSelectControls();
        applyFilters();
        scopeButtons[0]?.focus();
      }

      scopeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeScope = button.dataset.scope || 'all';
          applyFilters();
        });
      });
      categorySelect.addEventListener('change', () => {
        syncSelectControls();
        applyFilters();
      });
      languageSelect.addEventListener('change', () => {
        syncSelectControls();
        applyFilters();
      });
      searchInput.addEventListener('input', () => applyFilters());
      searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && searchInput.value) {
          searchInput.value = '';
          applyFilters();
        }
      });
      clearButtons.forEach((button) => button.addEventListener('click', clearFilters));
      form.addEventListener('submit', (event) => event.preventDefault());

      const previousLanguageHandler = window.__projectsDirectoryLanguageHandler;
      if (previousLanguageHandler) document.removeEventListener('languagechange', previousLanguageHandler);
      const previousPointerHandler = window.__projectsDirectoryPointerHandler;
      if (previousPointerHandler) document.removeEventListener('pointerdown', previousPointerHandler);
      const previousViewportHandler = window.__projectsDirectoryViewportHandler;
      if (previousViewportHandler) {
        window.removeEventListener('resize', previousViewportHandler);
        window.visualViewport?.removeEventListener('resize', previousViewportHandler);
        window.visualViewport?.removeEventListener('scroll', previousViewportHandler);
      }

      const pointerHandler = (event) => {
        selectControllers.forEach((controller) => {
          if (!controller.control.contains(event.target)) controller.close();
        });
      };
      const viewportHandler = () => selectControllers.forEach((controller) => controller.reposition());
      const languageHandler = () => {
        searchInput.placeholder =
          currentLanguage() === 'en' ? searchInput.dataset.placeholderEn : searchInput.dataset.placeholderZh;
        syncSelectControls();
        applyFilters({ announce: false, sync: false });
      };
      window.__projectsDirectoryLanguageHandler = languageHandler;
      window.__projectsDirectoryPointerHandler = pointerHandler;
      window.__projectsDirectoryViewportHandler = viewportHandler;
      document.addEventListener('languagechange', languageHandler);
      document.addEventListener('pointerdown', pointerHandler);
      window.addEventListener('resize', viewportHandler);
      window.visualViewport?.addEventListener('resize', viewportHandler);
      window.visualViewport?.addEventListener('scroll', viewportHandler);

      const cleanup = () => {
        document.removeEventListener('languagechange', languageHandler);
        document.removeEventListener('pointerdown', pointerHandler);
        window.removeEventListener('resize', viewportHandler);
        window.visualViewport?.removeEventListener('resize', viewportHandler);
        window.visualViewport?.removeEventListener('scroll', viewportHandler);
        if (window.__projectsDirectoryLanguageHandler === languageHandler) {
          delete window.__projectsDirectoryLanguageHandler;
        }
        if (window.__projectsDirectoryPointerHandler === pointerHandler) {
          delete window.__projectsDirectoryPointerHandler;
        }
        if (window.__projectsDirectoryViewportHandler === viewportHandler) {
          delete window.__projectsDirectoryViewportHandler;
        }
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });

      languageHandler();
      applyFilters({ announce: false });
      form.hidden = false;
    })();
  </script>
