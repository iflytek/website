---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

import { events, type Event } from '~/data/events';
import Layout from '~/layouts/PageLayout.astro';

export const prerender = true;

const metadata = {
  title: 'Events',
  description: '查看 Astron 开源社区即将举行与往期的 Meetup、会议、黑客松和工作坊。',
};

const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(new Date());

const eventRecords = events
  .map((event) => {
    const status: NonNullable<Event['status']> =
      event.date === today ? 'ongoing' : event.date > today ? 'upcoming' : 'past';
    return { ...event, status };
  })
  .sort((a, b) => b.date.localeCompare(a.date));

const upcomingEvents = eventRecords
  .filter((event) => event.status !== 'past')
  .sort((a, b) => a.date.localeCompare(b.date));
const pastEvents = eventRecords.filter((event) => event.status === 'past');

const typeLabels: Record<Event['type'], { zh: string; en: string }> = {
  conference: { zh: '会议', en: 'Conference' },
  meetup: { zh: 'Meetup', en: 'Meetup' },
  hackathon: { zh: '黑客松', en: 'Hackathon' },
  workshop: { zh: '工作坊', en: 'Workshop' },
  webinar: { zh: '线上分享', en: 'Webinar' },
};

const statusLabels: Record<NonNullable<Event['status']>, { zh: string; en: string }> = {
  upcoming: { zh: '即将举办', en: 'Upcoming' },
  ongoing: { zh: '进行中', en: 'Ongoing' },
  past: { zh: '已结束', en: 'Past' },
};

const eventTypeOrder: Event['type'][] = ['conference', 'meetup', 'hackathon', 'workshop', 'webinar'];
const archiveTypeSet = new Set(pastEvents.map((event) => event.type));
const archiveTypes = eventTypeOrder.filter((type) => archiveTypeSet.has(type));

const locationLabels: Record<string, { zh: string; en: string }> = {
  'Shanghai, China': { zh: '中国 · 上海', en: 'Shanghai, China' },
  'IBP International Conference Center, Shanghai, China': {
    zh: '中国 · 上海 · IBP 国际会议中心',
    en: 'IBP International Conference Center, Shanghai, China',
  },
  Online: { zh: '线上', en: 'Online' },
  'Tianjin, China': { zh: '中国 · 天津', en: 'Tianjin, China' },
  'Hefei, China': { zh: '中国 · 合肥', en: 'Hefei, China' },
  'Zhengzhou, China': { zh: '中国 · 郑州', en: 'Zhengzhou, China' },
  'Hangzhou, China': { zh: '中国 · 杭州', en: 'Hangzhou, China' },
  'Qingdao, China': { zh: '中国 · 青岛', en: 'Qingdao, China' },
  'Chongqing, China': { zh: '中国 · 重庆', en: 'Chongqing, China' },
  'Barcelona, Spain': { zh: '西班牙 · 巴塞罗那', en: 'Barcelona, Spain' },
  'Online + Hefei': { zh: '线上 + 中国 · 合肥', en: 'Online + Hefei' },
};

const localizeLocation = (location: string) => locationLabels[location] || { zh: location, en: location };

const eventDate = (date: string) => new Date(`${date}T00:00:00Z`);
const eventDateParts = (date: string) => {
  const [year, month, day] = date.split('-');
  const value = eventDate(date);
  return {
    year,
    month,
    day,
    monthEn: new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' }).format(value).toUpperCase(),
    weekdayZh: new Intl.DateTimeFormat('zh-CN', { weekday: 'short', timeZone: 'UTC' }).format(value),
    weekdayEn: new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'UTC' }).format(value).toUpperCase(),
  };
};

const formatNewsDate = (date: Date | undefined, locale: 'zh-CN' | 'en-US') =>
  date
    ? new Intl.DateTimeFormat(locale, {
        year: 'numeric',
        month: locale === 'zh-CN' ? 'numeric' : 'short',
        day: 'numeric',
        timeZone: 'UTC',
      }).format(date)
    : '';

const posts = await getCollection('post');
const postSlug = (post: (typeof posts)[number]) => post.id.replace(/\.(md|mdx)$/i, '');
const newsPosts = posts.filter((post) => post.data.category === 'news');
const englishNewsPosts = newsPosts.filter((post) => post.data.lang === 'en');
const newsItems = newsPosts
  .filter((post) => post.data.lang !== 'en')
  .sort((a, b) => new Date(b.data.publishDate || 0).getTime() - new Date(a.data.publishDate || 0).getTime())
  .slice(0, 4)
  .map((post) => {
    const zhSlug = postSlug(post);
    const englishPost = englishNewsPosts.find((candidate) => {
      const enSlug = postSlug(candidate);
      return (
        enSlug === `${zhSlug}-en` ||
        enSlug === post.data.translationId ||
        candidate.data.translationId === zhSlug ||
        candidate.data.translationId === post.id
      );
    });
    const englishSource = englishPost || post;
    const publishDate = post.data.publishDate ? new Date(post.data.publishDate) : undefined;

    return {
      hrefZh: `/blog/${zhSlug}`,
      hrefEn: `/blog/${postSlug(englishSource)}`,
      titleZh: post.data.title,
      titleEn: englishSource.data.title,
      excerptZh: post.data.excerpt || '',
      excerptEn: englishSource.data.excerpt || post.data.excerpt || '',
      dateZh: formatNewsDate(publishDate, 'zh-CN'),
      dateEn: formatNewsDate(publishDate, 'en-US'),
      isoDate: publishDate?.toISOString() || '',
    };
  });
---

<Layout metadata={metadata}>
  <div class="events-page" data-events-directory>
    <header class="events-hero">
      <div class="events-shell events-hero__inner">
        <div class="events-hero__copy">
          <h1 data-lang-zh="社区活动" data-lang-en="Community events">社区活动</h1>
          <p
            data-lang-zh="从 Meetup、会议到黑客松与工作坊，跟进 Astron 开源社区的下一场交流，也可回看过往活动。"
            data-lang-en="Follow the next Astron open-source community meetup, conference, hackathon, or workshop—and revisit the past program."
          >
            从 Meetup、会议到黑客松与工作坊，跟进 Astron 开源社区的下一场交流，也可回看过往活动。
          </p>
        </div>
        <p
          class="events-hero__summary"
          aria-label="活动概览"
          data-aria-label-zh="活动概览"
          data-aria-label-en="Event overview"
        >
          <span>
            <strong>{upcomingEvents.length}</strong>
            <span data-lang-zh="场接下来" data-lang-en="next">场接下来</span>
          </span>
          <span>
            <strong>{pastEvents.length}</strong>
            <span data-lang-zh="场往期活动" data-lang-en="past events">场往期活动</span>
          </span>
          <span data-lang-zh="线下 · 线上 · 混合" data-lang-en="In person · Online · Hybrid">线下 · 线上 · 混合</span>
        </p>
      </div>
    </header>

    <section class="events-section events-next" aria-labelledby="events-next-title">
      <div class="events-shell">
        <header class="events-section__heading">
          <h2 id="events-next-title" data-lang-zh="接下来" data-lang-en="Coming up">接下来</h2>
        </header>

        {
          upcomingEvents.length > 0 ? (
            <ol class="events-next__list" role="list">
              {upcomingEvents.map((event) => {
                const date = eventDateParts(event.date);
                const location = localizeLocation(event.location);
                return (
                  <li class="event-next-row">
                    <time class="event-next-date" datetime={event.date}>
                      <span
                        class="event-next-date__month"
                        data-lang-zh={`${date.month} 月`}
                        data-lang-en={date.monthEn}
                      >
                        {date.month} 月
                      </span>
                      <strong>{date.day}</strong>
                      <span
                        class="event-next-date__foot"
                        data-lang-zh={`${date.year} · ${date.weekdayZh}`}
                        data-lang-en={`${date.year} · ${date.weekdayEn}`}
                      >
                        {date.year} · {date.weekdayZh}
                      </span>
                    </time>

                    <article class="event-next-content">
                      <div class="event-next-content__meta">
                        <span
                          class="event-type-signal"
                          data-lang-zh={typeLabels[event.type].zh}
                          data-lang-en={typeLabels[event.type].en}
                        >
                          {typeLabels[event.type].zh}
                        </span>
                        <span
                          class:list={['event-status-signal', `event-status-signal--${event.status}`]}
                          data-lang-zh={statusLabels[event.status].zh}
                          data-lang-en={statusLabels[event.status].en}
                        >
                          {statusLabels[event.status].zh}
                        </span>
                      </div>
                      <h3>
                        <span data-lang-zh={event.titleZh} data-lang-en={event.title}>
                          {event.titleZh}
                        </span>
                      </h3>
                      {(event.subtitle || event.subtitleEn) && (
                        <p
                          class="event-next-content__subtitle"
                          data-lang-zh={event.subtitle || event.titleZh}
                          data-lang-en={event.subtitleEn || event.title}
                        >
                          {event.subtitle || event.titleZh}
                        </p>
                      )}
                      <p
                        class="event-next-content__description"
                        data-lang-zh={event.description}
                        data-lang-en={event.descriptionEn}
                      >
                        {event.description}
                      </p>
                      <p class="event-location">
                        <Icon name="tabler:map-pin" aria-hidden="true" />
                        <span data-lang-zh={location.zh} data-lang-en={location.en}>
                          {location.zh}
                        </span>
                      </p>
                    </article>

                    <div class="event-next-action">
                      {event.link ? (
                        <a href={event.link} target="_blank" rel="noopener noreferrer">
                          <span data-lang-zh="查看活动详情" data-lang-en="Event details">
                            查看活动详情
                          </span>
                          <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                        </a>
                      ) : (
                        <span data-lang-zh="暂无外部链接" data-lang-en="No external link">
                          暂无外部链接
                        </span>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
          ) : (
            <div class="events-static-empty">
              <p data-lang-zh="当前没有已公布的近期活动。" data-lang-en="No upcoming events have been announced yet.">
                当前没有已公布的近期活动。
              </p>
              <span
                data-lang-zh="新活动确认后会在此更新；你仍可浏览完整往期记录。"
                data-lang-en="New events will appear here once confirmed. The complete past program remains available below."
              >
                新活动确认后会在此更新；你仍可浏览完整往期记录。
              </span>
            </div>
          )
        }
      </div>
    </section>

    <section class="events-section events-archive" aria-labelledby="events-archive-title">
      <div class="events-shell">
        <header class="events-section__heading events-section__heading--archive">
          <h2 id="events-archive-title" data-lang-zh="往期活动" data-lang-en="Past events">往期活动</h2>
        </header>

        <form class="events-filters" data-event-filters novalidate hidden>
          <div
            class="events-filters__track"
            role="group"
            aria-label="筛选往期活动"
            data-aria-label-zh="筛选往期活动"
            data-aria-label-en="Filter past events"
          >
            <button type="button" data-event-type="all" aria-pressed="true">
              <span data-lang-zh="全部" data-lang-en="All">全部</span>
              <span class="events-filter-count">{pastEvents.length}</span>
            </button>
            {
              archiveTypes.map((type) => (
                <button type="button" data-event-type={type} aria-pressed="false">
                  <span data-lang-zh={typeLabels[type].zh} data-lang-en={typeLabels[type].en}>
                    {typeLabels[type].zh}
                  </span>
                  <span class="events-filter-count">{pastEvents.filter((event) => event.type === type).length}</span>
                </button>
              ))
            }
          </div>
        </form>

        <div class="events-archive__status">
          <p
            data-event-result-count
            data-template-zh="显示 {count} 场往期活动"
            data-template-en="Showing {count} past events"
          >
            显示 {pastEvents.length} 场往期活动
          </p>
          <button type="button" data-clear-event-filter hidden>
            <span data-lang-zh="清除筛选" data-lang-en="Clear filter">清除筛选</span>
          </button>
          <p class="sr-only" aria-live="polite" aria-atomic="true" data-event-result-live></p>
        </div>

        <ol class="events-archive__list" role="list">
          {
            pastEvents.map((event) => {
              const date = eventDateParts(event.date);
              const location = localizeLocation(event.location);
              return (
                <li class="event-archive-row" data-event-item data-event-type={event.type}>
                  <time class="event-archive-date" datetime={event.date}>
                    <strong>{date.year}</strong>
                    <span>
                      {date.month}.{date.day}
                    </span>
                  </time>
                  <p
                    class="event-archive-type"
                    data-lang-zh={typeLabels[event.type].zh}
                    data-lang-en={typeLabels[event.type].en}
                  >
                    {typeLabels[event.type].zh}
                  </p>
                  <article class="event-archive-main">
                    <h3 data-lang-zh={event.titleZh} data-lang-en={event.title}>
                      {event.titleZh}
                    </h3>
                    <p data-lang-zh={event.description} data-lang-en={event.descriptionEn}>
                      {event.description}
                    </p>
                  </article>
                  <p class="event-archive-location">
                    <Icon name="tabler:map-pin" aria-hidden="true" />
                    <span data-lang-zh={location.zh} data-lang-en={location.en}>
                      {location.zh}
                    </span>
                  </p>
                  <div class="event-archive-action">
                    {event.link ? (
                      <a
                        href={event.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${event.titleZh}：查看活动详情`}
                        data-aria-label-zh={`${event.titleZh}：查看活动详情`}
                        data-aria-label-en={`${event.title}: View event details`}
                      >
                        <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                      </a>
                    ) : (
                      <span>
                        <span aria-hidden="true">—</span>
                        <span class="sr-only" data-lang-zh="暂无外部链接" data-lang-en="No external link">
                          暂无外部链接
                        </span>
                      </span>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>

        <div class="events-filter-empty" data-event-empty hidden>
          <p data-lang-zh="没有这一类型的往期活动。" data-lang-en="No past events match this format.">
            没有这一类型的往期活动。
          </p>
          <button type="button" data-clear-event-filter>
            <span data-lang-zh="查看全部活动" data-lang-en="View all events">查看全部活动</span>
          </button>
        </div>
      </div>
    </section>

    {
      newsItems.length > 0 && (
        <section class="events-section events-news" aria-labelledby="events-news-title">
          <div class="events-shell">
            <header class="events-section__heading">
              <h2 id="events-news-title" data-lang-zh="最新动态" data-lang-en="Latest news">
                最新动态
              </h2>
            </header>

            <ol class="events-news__list" role="list">
              {newsItems.map((news) => (
                <li>
                  <a href={news.hrefZh} data-news-link data-href-zh={news.hrefZh} data-href-en={news.hrefEn}>
                    <div class="events-news__meta">
                      <span>NEWS</span>
                      <time datetime={news.isoDate} data-lang-zh={news.dateZh} data-lang-en={news.dateEn}>
                        {news.dateZh}
                      </time>
                    </div>
                    <h3 data-lang-zh={news.titleZh} data-lang-en={news.titleEn}>
                      {news.titleZh}
                    </h3>
                    {news.excerptZh && (
                      <p data-lang-zh={news.excerptZh} data-lang-en={news.excerptEn}>
                        {news.excerptZh}
                      </p>
                    )}
                    <span class="events-news__action">
                      <span data-lang-zh="阅读动态" data-lang-en="Read update">
                        阅读动态
                      </span>
                      <Icon name="tabler:arrow-right" aria-hidden="true" />
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      const root = document.querySelector('[data-events-directory]');
      if (!root || root.dataset.eventsReady === 'true') return;
      root.dataset.eventsReady = 'true';

      const form = root.querySelector('[data-event-filters]');
      const buttons = Array.from(root.querySelectorAll('[data-event-type]'));
      const items = Array.from(root.querySelectorAll('[data-event-item]'));
      const resultCount = root.querySelector('[data-event-result-count]');
      const resultLive = root.querySelector('[data-event-result-live]');
      const emptyState = root.querySelector('[data-event-empty]');
      const clearButtons = Array.from(root.querySelectorAll('[data-clear-event-filter]'));
      const newsLinks = Array.from(root.querySelectorAll('[data-news-link]'));

      if (!form || buttons.length === 0 || !resultCount || !emptyState) return;

      const validTypes = new Set(buttons.map((button) => button.dataset.eventType));
      const url = new URL(window.location.href);
      const requestedType = url.searchParams.get('type') || 'all';
      let activeType = validTypes.has(requestedType) ? requestedType : 'all';
      const currentLanguage = () => (localStorage.lang === 'en' ? 'en' : 'zh');

      const localizedResult = (count) => {
        if (currentLanguage() === 'en') return count === 1 ? 'Showing 1 past event' : `Showing ${count} past events`;
        return `显示 ${count} 场往期活动`;
      };

      const syncUrl = () => {
        const nextUrl = new URL(window.location.href);
        if (activeType === 'all') nextUrl.searchParams.delete('type');
        else nextUrl.searchParams.set('type', activeType);
        window.history.replaceState(window.history.state, '', nextUrl);
      };

      const syncLocalizedAttributes = () => {
        const language = currentLanguage();
        newsLinks.forEach((link) => {
          link.href = language === 'en' ? link.dataset.hrefEn : link.dataset.hrefZh;
        });
        root.querySelectorAll('[data-aria-label-zh]').forEach((element) => {
          const label = language === 'en' ? element.dataset.ariaLabelEn : element.dataset.ariaLabelZh;
          if (label) element.setAttribute('aria-label', label);
        });
      };

      const applyFilter = ({ announce = true, sync = true } = {}) => {
        let visibleCount = 0;

        items.forEach((item) => {
          const visible = activeType === 'all' || item.dataset.eventType === activeType;
          item.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.eventType === activeType));
        });

        resultCount.textContent = localizedResult(visibleCount);
        if (announce && resultLive) resultLive.textContent = localizedResult(visibleCount);
        emptyState.hidden = visibleCount !== 0;
        clearButtons.forEach((button) => {
          if (!button.closest('[data-event-empty]')) button.hidden = activeType === 'all';
        });
        if (sync) syncUrl();
      };

      const clearFilter = () => {
        activeType = 'all';
        applyFilter();
        buttons[0]?.focus();
      };

      const filterHandler = (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest('[data-event-type]');
        if (!button || !form.contains(button)) return;
        activeType = button.dataset.eventType || 'all';
        applyFilter();
      };

      form.addEventListener('click', filterHandler);
      clearButtons.forEach((button) => button.addEventListener('click', clearFilter));
      form.addEventListener('submit', (event) => event.preventDefault());

      const previousLanguageHandler = window.__eventsDirectoryLanguageHandler;
      if (previousLanguageHandler) document.removeEventListener('languagechange', previousLanguageHandler);

      const languageHandler = () => {
        syncLocalizedAttributes();
        applyFilter({ announce: false, sync: false });
      };
      window.__eventsDirectoryLanguageHandler = languageHandler;
      document.addEventListener('languagechange', languageHandler);

      const cleanup = () => {
        document.removeEventListener('languagechange', languageHandler);
        if (window.__eventsDirectoryLanguageHandler === languageHandler) {
          delete window.__eventsDirectoryLanguageHandler;
        }
      };
      document.addEventListener('astro:before-swap', cleanup, { once: true });

      syncLocalizedAttributes();
      applyFilter({ announce: false });
      form.hidden = false;
    })();
  </script>
</Layout>

<style>
  .events-page {
    min-height: 100vh;
    overflow: clip;
    background: var(--rc-canvas);
    color: var(--rc-text);
  }

  .events-shell {
    width: min(calc(100% - 3rem), 87.5rem);
    margin-inline: auto;
  }

  .events-hero {
    padding: clamp(3.75rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--rc-rule);
  }

  .events-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: end;
  }

  .events-hero__copy {
    max-width: 54rem;
  }

  .events-hero h1 {
    margin: 0;
    color: var(--rc-text-strong);
    font-size: clamp(2.6rem, 5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .events-hero__copy > p {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    color: var(--rc-text-muted);
    font-size: 1rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .events-hero__summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem 1.25rem;
    align-items: center;
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rc-rule-strong);
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .events-hero__summary > span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .events-hero__summary strong {
    color: var(--rc-text-strong);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .events-section {
    padding: clamp(4.5rem, 8vw, 7.5rem) 0;
  }

  .events-section + .events-section {
    border-top: 1px solid var(--rc-rule);
  }

  .events-section__heading {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }

  .events-section__heading h2 {
    margin: 0;
    color: var(--rc-text-strong);
    font-size: var(--rc-type-section-heading);
    font-weight: 680;
    letter-spacing: -0.04em;
