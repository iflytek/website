---
import Layout from '~/layouts/PageLayout.astro';
import ReleaseCurrent from '~/components/home/ReleaseCurrent.astro';
import ProjectLandscape from '~/components/home/ProjectLandscape.astro';
import LatestPosts from '~/components/home/LatestPosts.astro';
import AdopterLogoLoop from '~/components/home/AdopterLogoLoop.astro';
import CommunityCTA from '~/components/home/CommunityCTA.astro';

import { getCollection } from 'astro:content';
import { fetchAllPosts } from '~/utils/blog';
import { getProjectsWithStats } from '~/utils/project-stats';

const metadata = {
  title: 'Astron 企业级 Agentic AI 开源生态 — 讯飞开源',
  description: '探索以 Astron 为核心的企业级 Agentic AI 开源生态，发现真实项目、技术内容与社区贡献路径。',
  ignoreTitleTemplate: true,
};

const PROJECT_PREVIEW_ORDER = ['iflytek/astron-agent', 'iflytek/astron-rpa', 'iflytek/skillhub'] as const;

const [projects, allPosts, adopters] = await Promise.all([
  getProjectsWithStats(),
  fetchAllPosts(),
  getCollection('adopter'),
]);
const latestPosts = allPosts.filter((post) => post.lang === 'zh').slice(0, 3);
const latestEnglishPosts = latestPosts.map((post) => (post.translation?.lang === 'en' ? post.translation : post));
const orderedAdopters = [...adopters].sort((a, b) => a.id.localeCompare(b.id));

const projectByRepo = new Map(projects.map((project) => [project.data.repo, project]));
const orderedRepos = new Set<string>(PROJECT_PREVIEW_ORDER);
const explicitlyOrderedProjects = PROJECT_PREVIEW_ORDER.flatMap((repo) => {
  const project = projectByRepo.get(repo);
  return project ? [project] : [];
});
const fallbackProjects = projects.filter((project) => !orderedRepos.has(project.data.repo));
const releaseProjects = [...explicitlyOrderedProjects, ...fallbackProjects].slice(0, 3).map((project) => ({
  slug: project.id.replace(/\.(yaml|yml)$/i, ''),
  name: project.data.name,
  nameEn: project.data.nameEn || project.data.name,
  category: project.data.category,
}));

const totalStars = projects.reduce((sum, project) => sum + (project.data.stars || 0), 0);
const formatCompact = (value: number) => {
  if (value < 1000) return value.toLocaleString('en-US');
  const compact = (value / 1000).toFixed(1).replace(/\.0$/, '');
  return `${compact}K`;
};
---

<Layout metadata={metadata}>
  <div class="release-home">
    <ReleaseCurrent projects={releaseProjects} projectCount={projects.length} starDisplay={formatCompact(totalStars)} />
    <ProjectLandscape />
    <LatestPosts posts={latestPosts} englishPosts={latestEnglishPosts} />
    <AdopterLogoLoop adopters={orderedAdopters} />
    <CommunityCTA />
  </div>
</Layout>

<style>
  .release-home {
    min-height: 100vh;
    overflow: clip;
    background: #010208;
    color: #e9e9e9;
    color-scheme: dark;
  }

  :global(.release-home ::selection) {
    background: #2864e4;
    color: #fff;
  }
</style>
