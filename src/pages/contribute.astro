---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import ContributorsCanvas from '~/components/contribute/ContributorsCanvas.astro';
import Layout from '~/layouts/PageLayout.astro';

export const prerender = true;

const metadata = {
  title: '参与贡献',
  description: '选择适合你的贡献路径，了解讯飞开源项目的贡献流程，并认识参与 Astron 开源生态建设的社区贡献者。',
};

interface Contributor {
  username: string;
  avatar_url: string;
  contributions: number;
  profile_url: string;
}

interface ContributorsCache {
  contributors?: Contributor[];
}

interface ContributionAction {
  labelZh: string;
  labelEn: string;
  href: string;
  external: boolean;
}

function loadContributorsCache(): ContributorsCache {
  try {
    const cachePath = join(process.cwd(), '.cache/contributors.json');
    return JSON.parse(readFileSync(cachePath, 'utf-8')) as ContributorsCache;
  } catch {
    return {};
  }
}

function avatarUrl(url: string, size = 96) {
  return url + (url.includes('?') ? '&' : '?') + 's=' + size;
}

const projects = await getCollection('project');
const contributorCache = loadContributorsCache();
const contributors = [...(contributorCache.contributors || [])].sort((a, b) => b.contributions - a.contributions);
const topContributors = contributors.slice(0, 12);
const totalCodeCommits = contributors.reduce((sum, contributor) => sum + contributor.contributions, 0);
const formatNumber = (value: number) => value.toLocaleString('en-US');

const contributionPaths = [
  {
    number: '01',
    icon: 'tabler:message-report',
    titleZh: '问题与建议',
    titleEn: 'Issues and ideas',
    descriptionZh: '报告可复现的问题，或在开始重大改动前与维护者讨论想法。',
    descriptionEn: 'Report a reproducible problem, or discuss an idea with maintainers before significant work begins.',
    actions: [
      { labelZh: '报告问题：选择项目', labelEn: 'Report a bug: choose a project', href: '/projects', external: false },
      {
        labelZh: '提出建议：阅读讨论指南',
        labelEn: 'Suggest an idea: read the guide',
        href: 'https://github.com/iflytek/community/blob/master/contribute/discussions-guidelines.md',
        external: true,
      },
    ],
  },
  {
    number: '02',
    icon: 'tabler:code',
    titleZh: '代码与文档',
    titleEn: 'Code and documentation',
    descriptionZh: '遵循目标项目规则，提交范围清晰、包含必要测试或文档说明的改进。',
    descriptionEn:
      'Follow the target project’s rules and submit a focused improvement with the required tests or documentation.',
    actions: [
      {
        labelZh: '提交代码：阅读 PR 指南',
        labelEn: 'Submit code: read the PR guide',
        href: 'https://github.com/iflytek/community/blob/master/contribute/pull-request-guidelines.md',
        external: true,
      },
      { labelZh: '完善文档：选择项目', labelEn: 'Improve docs: choose a project', href: '/projects', external: false },
    ],
  },
  {
    number: '03',
    icon: 'tabler:users-group',
    titleZh: '分享与社区',
    titleEn: 'Sharing and community',
    descriptionZh: '分享真实使用经验、帮助新用户，并在开放、尊重的社区中共同协作。',
    descriptionEn: 'Share real usage experience, help newcomers, and collaborate in an open and respectful community.',
    actions: [
      {
        labelZh: '浏览 GitHub 组织',
        labelEn: 'Explore the GitHub organization',
        href: 'https://github.com/iflytek',
        external: true,
      },
      {
        labelZh: '加入 Discord 讨论',
        labelEn: 'Join the Discord community',
        href: 'https://discord.gg/UgnuzaJKwc',
        external: true,
      },
    ],
  },
] as const;

const workflow = [
  {
    number: '01',
    titleZh: '找到任务',
    titleEn: 'Find the work',
    descriptionZh: '从公开 Issue、Good First Issues 或社区讨论中选择一个明确问题。',
    descriptionEn: 'Choose a clear problem from open Issues, Good First Issues, or a community discussion.',
  },
  {
    number: '02',
    titleZh: '阅读规则',
    titleEn: 'Read the rules',
    descriptionZh: '打开目标仓库的贡献指南，确认分支、测试和提交要求。',
    descriptionEn: 'Read the target repository’s guide for its branch, test, and submission requirements.',
  },
  {
    number: '03',
    titleZh: '先行讨论',
    titleEn: 'Discuss first',
    descriptionZh: '开始重大改动前先提交 Issue，与维护者对齐范围和实现方向。',
    descriptionEn: 'Before significant work, open an Issue and align the scope and approach with maintainers.',
  },
  {
    number: '04',
    titleZh: '提交评审',
    titleEn: 'Submit for review',
    descriptionZh: '完成实现和测试，提交范围清晰的 Pull Request 并参与评审。',
    descriptionEn: 'Complete the work and tests, submit a focused Pull Request, and take part in review.',
  },
] as const;

const guidanceLinks = [
  {
    labelZh: 'Issue 指南',
    labelEn: 'Issue guidelines',
    noteZh: '搜索、提交与问题生命周期',
    noteEn: 'Search, filing, and the issue lifecycle',
    href: 'https://github.com/iflytek/community/blob/master/contribute/issue-guidelines.md',
  },
  {
    labelZh: 'Pull Request 指南',
    labelEn: 'Pull Request guidelines',
    noteZh: '提交、测试与评审实践',
    noteEn: 'Submission, testing, and review practices',
    href: 'https://github.com/iflytek/community/blob/master/contribute/pull-request-guidelines.md',
  },
  {
    labelZh: '社区行为准则',
    labelEn: 'Code of Conduct',
    noteZh: '开放、包容与相互尊重',
    noteEn: 'Open, inclusive, and respectful collaboration',
    href: 'https://github.com/iflytek/community/blob/master/code-of-conduct.md',
  },
  {
    labelZh: 'Discord 社区',
    labelEn: 'Discord community',
    noteZh: '参与讨论与寻求帮助',
    noteEn: 'Join discussions and ask for help',
    href: 'https://discord.gg/UgnuzaJKwc',
  },
] as const;
---

<Layout metadata={metadata}>
  <div class="contribute-page">
    <section class="contribute-hero" aria-labelledby="contribute-title">
      <div class="contribute-shell">
        <div class="contribute-hero__copy">
          <p class="contribute-kicker" data-lang-zh="社区 / 参与贡献" data-lang-en="Community / Contribute">
            社区 / 参与贡献
          </p>
          <h1 id="contribute-title" data-lang-zh="让开源因你的参与更进一步" data-lang-en="Move open source forward">
            让开源因你的参与更进一步
          </h1>
          <p
            class="contribute-hero__summary"
            data-lang-zh="无论是一个问题、一段代码、一篇文档，还是一次耐心的解答，都能成为 Astron 开源生态持续生长的一部分。"
            data-lang-en="A thoughtful issue, a focused patch, clearer documentation, or a patient answer can all help the Astron open-source ecosystem grow."
          >
            无论是一个问题、一段代码、一篇文档，还是一次耐心的解答，都能成为 Astron 开源生态持续生长的一部分。
          </p>
          <div class="contribute-hero__actions">
            <a
              class="contribute-action contribute-action--primary"
              href="https://github.com/search?q=org%3Aiflytek+label%3A%22good+first+issue%22+state%3Aopen&type=issues"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-lang-zh="查看 Good First Issues" data-lang-en="View Good First Issues"
                >查看 Good First Issues</span
              >
              <Icon name="tabler:arrow-up-right" aria-hidden="true" />
            </a>
            <a
              class="contribute-action contribute-action--secondary"
              href="https://github.com/iflytek/community/blob/master/CONTRIBUTING.md"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span data-lang-zh="阅读贡献指南" data-lang-en="Read the contribution guide">阅读贡献指南</span>
              <Icon name="tabler:arrow-up-right" aria-hidden="true" />
            </a>
          </div>
        </div>

        <div class="contribute-proof" aria-labelledby="contribute-proof-label">
          <h2
            id="contribute-proof-label"
            class="sr-only"
            data-lang-zh="社区代码贡献数据"
            data-lang-en="Community code contribution data"
          >
            社区代码贡献数据
          </h2>
          <dl class="contribute-proof__grid">
            <div>
              <dt data-lang-zh="代码贡献者" data-lang-en="Code contributors">代码贡献者</dt>
              <dd>{formatNumber(contributors.length)}</dd>
            </div>
            <div>
              <dt data-lang-zh="代码提交" data-lang-en="Code commits">代码提交</dt>
              <dd>{formatNumber(totalCodeCommits)}</dd>
            </div>
            <div>
              <dt data-lang-zh="开源项目" data-lang-en="Open-source projects">开源项目</dt>
              <dd>{formatNumber(projects.length)}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="contribution-paths" class="contribute-section" aria-labelledby="paths-title">
      <div class="contribute-shell">
        <header class="contribute-section__header">
          <p class="contribute-section__index">01 / PATHS</p>
          <div>
            <h2 id="paths-title" data-lang-zh="选择适合你的贡献方式" data-lang-en="Choose how you want to contribute">
              选择适合你的贡献方式
            </h2>
            <p
              data-lang-zh="先按你的意图找到入口；涉及具体项目时，再进入目标仓库确认它自己的贡献规则。"
              data-lang-en="Start with your intent. For project-specific work, continue to the target repository and follow its own contribution rules."
            >
              先按你的意图找到入口；涉及具体项目时，再进入目标仓库确认它自己的贡献规则。
            </p>
          </div>
        </header>

        <div class="contribution-path-grid">
          {
            contributionPaths.map((item) => (
              <article class="contribution-path">
                <div class="contribution-path__meta">
                  <span>{item.number}</span>
                  <span class="contribution-path__icon" aria-hidden="true">
                    <Icon name={item.icon} />
                  </span>
                </div>
                <h3 data-lang-zh={item.titleZh} data-lang-en={item.titleEn}>
                  {item.titleZh}
                </h3>
                <p data-lang-zh={item.descriptionZh} data-lang-en={item.descriptionEn}>
                  {item.descriptionZh}
                </p>
                <div class="contribution-path__actions">
                  {item.actions.map((action: ContributionAction) => (
                    <a
                      href={action.href}
                      target={action.external ? '_blank' : undefined}
                      rel={action.external ? 'noopener noreferrer' : undefined}
                    >
                      <span data-lang-zh={action.labelZh} data-lang-en={action.labelEn}>
                        {action.labelZh}
                      </span>
                      <Icon
                        name={action.external ? 'tabler:arrow-up-right' : 'tabler:arrow-right'}
                        aria-hidden="true"
                      />
                    </a>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="contribute-section" aria-labelledby="workflow-title">
      <div class="contribute-shell">
        <header class="contribute-section__header">
          <p class="contribute-section__index">02 / PROCESS</p>
          <div>
            <h2 id="workflow-title" data-lang-zh="从任务到评审" data-lang-en="From task to review">从任务到评审</h2>
            <p
              data-lang-zh="不同项目可能有额外要求；以下流程与社区贡献指南保持一致，并把项目规则放在实现之前。"
              data-lang-en="Individual projects may add requirements. This sequence follows the community guide and puts repository-specific rules before implementation."
            >
              不同项目可能有额外要求；以下流程与社区贡献指南保持一致，并把项目规则放在实现之前。
            </p>
          </div>
        </header>

        <ol class="contribution-workflow">
          {
            workflow.map((item) => (
              <li>
                <span class="contribution-workflow__number">{item.number}</span>
                <h3 data-lang-zh={item.titleZh} data-lang-en={item.titleEn}>
                  {item.titleZh}
                </h3>
                <p data-lang-zh={item.descriptionZh} data-lang-en={item.descriptionEn}>
                  {item.descriptionZh}
                </p>
              </li>
            ))
          }
        </ol>

        <div class="contribute-guidance">
          <div class="contribute-guidance__intro">
            <p class="contribute-section__index">GUIDANCE / COMMUNITY</p>
            <h3
              id="contribution-guidance-title"
              data-lang-zh="规则、评审与求助入口"
              data-lang-en="Guidance, review, and support"
            >
              规则、评审与求助入口
            </h3>
            <p
              data-lang-zh="遇到不确定的问题时，先阅读对应指南；仍需帮助，再进入社区讨论。"
              data-lang-en="When something is unclear, start with the relevant guide, then bring the remaining question to the community."
            >
              遇到不确定的问题时，先阅读对应指南；仍需帮助，再进入社区讨论。
            </p>
          </div>
          <nav class="contribute-guidance__links" aria-labelledby="contribution-guidance-title">
            {
              guidanceLinks.map((item) => (
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <span>
                    <strong data-lang-zh={item.labelZh} data-lang-en={item.labelEn}>
                      {item.labelZh}
                    </strong>
                    <small data-lang-zh={item.noteZh} data-lang-en={item.noteEn}>
                      {item.noteZh}
                    </small>
                  </span>
                  <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </section>

    <section class="contribute-section contribute-recognition" aria-labelledby="contributors-title">
      <div class="contribute-shell">
        <header class="contribute-section__header">
          <p class="contribute-section__index">03 / PEOPLE</p>
          <div>
            <h2
              id="contributors-title"
              data-lang-zh="每一次贡献，都值得被看见"
              data-lang-en="Every contribution deserves recognition"
            >
              每一次贡献，都值得被看见
            </h2>
            <p
              data-lang-zh="头像墙以公开仓库中的代码贡献者拼出 iFLYTEK；下方语义化名单可直接访问贡献者主页。"
              data-lang-en="The portrait field forms iFLYTEK from public-repository code contributors. Use the semantic list below to open contributor profiles."
            >
              头像墙以公开仓库中的代码贡献者拼出 iFLYTEK；下方语义化名单可直接访问贡献者主页。
            </p>
          </div>
        </header>

        {
          contributors.length > 0 ? (
            <ContributorsCanvas contributors={contributors} />
          ) : (
            <div class="contributor-empty">
              <Icon name="tabler:users" aria-hidden="true" />
              <p data-lang-zh="贡献者数据暂时不可用" data-lang-en="Contributor data is temporarily unavailable">
                贡献者数据暂时不可用
              </p>
            </div>
          )
        }

        {
          topContributors.length > 0 && (
            <div class="contributor-ranking">
              <div class="contributor-ranking__header">
                <h3 data-lang-zh="代码贡献者排行" data-lang-en="Top code contributors">
                  代码贡献者排行
                </h3>
              </div>
              <ol class="contributor-ranking__list">
                {topContributors.map((contributor, index) => (
                  <li>
                    <a href={contributor.profile_url} target="_blank" rel="noopener noreferrer">
                      <span class="contributor-ranking__rank" data-top-rank={index < 3 ? 'true' : undefined}>
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <img
                        src={avatarUrl(contributor.avatar_url)}
                        width="44"
                        height="44"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="contributor-ranking__identity">
                        <strong>{contributor.username}</strong>
                        <small
                          data-lang-zh={formatNumber(contributor.contributions) + ' 次代码提交'}
                          data-lang-en={formatNumber(contributor.contributions) + ' code commits'}
                        >
                          {formatNumber(contributor.contributions)} 次代码提交
                        </small>
                      </span>
                      <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        {
          contributors.length > 0 && (
            <details class="contributor-directory">
              <summary>
                <span
                  data-lang-zh={`浏览全部 ${formatNumber(contributors.length)} 位贡献者主页`}
                  data-lang-en={`Browse all ${formatNumber(contributors.length)} contributor profiles`}
                >
                  浏览全部 {formatNumber(contributors.length)} 位贡献者主页
                </span>
              </summary>
              <ul>
                {contributors.map((contributor) => (
                  <li>
                    <a href={contributor.profile_url} target="_blank" rel="noopener noreferrer">
                      <strong>{contributor.username}</strong>
                      <small
                        data-lang-zh={formatNumber(contributor.contributions) + ' 次代码提交'}
                        data-lang-en={formatNumber(contributor.contributions) + ' code commits'}
                      >
                        {formatNumber(contributor.contributions)} 次代码提交
                      </small>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </section>

    <section class="contribute-join" aria-labelledby="join-title">
      <div class="contribute-shell">
        <div class="contribute-join__panel">
          <div>
            <p class="contribute-section__index">04 / JOIN</p>
            <h2
              id="join-title"
              data-lang-zh="选择一个入口，开始你的第一次贡献"
              data-lang-en="Choose an entry point and make your first contribution"
            >
              选择一个入口，开始你的第一次贡献
            </h2>
          </div>
          <div>
            <p
              data-lang-zh="从一个小而明确的问题开始，与维护者保持沟通，让每一次改进都更容易进入项目。"
              data-lang-en="Start with a small, clear problem and stay in conversation with maintainers so each improvement can move smoothly into the project."
            >
              从一个小而明确的问题开始，与维护者保持沟通，让每一次改进都更容易进入项目。
            </p>
            <div class="contribute-join__actions">
              <a class="contribute-action contribute-action--primary" href="/projects">
                <span data-lang-zh="选择一个项目" data-lang-en="Choose a project">选择一个项目</span>
                <Icon name="tabler:arrow-right" aria-hidden="true" />
              </a>
              <a
                class="contribute-action contribute-action--secondary"
                href="https://discord.gg/UgnuzaJKwc"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span data-lang-zh="加入 Discord" data-lang-en="Join Discord">加入 Discord</span>
                <Icon name="tabler:arrow-up-right" aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contribute-page {
    min-height: 100vh;
    overflow: clip;
    background: var(--rc-canvas);
    color: var(--rc-text);
  }

  .contribute-shell {
    width: min(calc(100% - 3rem), 87.5rem);
    margin: 0 auto;
  }

  .contribute-hero {
    position: relative;
    padding: clamp(4.5rem, 8vw, 8rem) 0 clamp(4rem, 7vw, 6.75rem);
    border-bottom: 1px solid var(--rc-rule);
  }

  .contribute-hero__copy {
    max-width: 68rem;
  }

  .contribute-kicker,
  .contribute-section__index {
    margin: 0;
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .contribute-kicker::before {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-right: 0.625rem;
    border-radius: 50%;
    background: var(--rc-blue);
    box-shadow: 0 0 0.8rem rgb(60 143 247 / 48%);
    content: '';
    vertical-align: 0.08em;
  }

  .contribute-hero h1 {
    max-width: 65rem;
    margin: 1.5rem 0 0;
    color: var(--rc-text-strong);
    font-size: clamp(2.6rem, 5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .contribute-hero__summary {
    max-width: 46rem;
    margin: 1.75rem 0 0;
    color: var(--rc-text-muted);
    font-size: 1rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  .contribute-hero__actions,
  .contribute-join__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 2rem;
  }

  .contribute-action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--rc-radius-control);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .contribute-action :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .contribute-action--primary {
    border-color: var(--rc-header-rule);
    background: var(--rc-surface-raised);
    color: var(--rc-text-strong);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
  }

  .contribute-action--secondary {
    border-color: var(--rc-rule-strong);
    background: var(--rc-surface);
    color: var(--rc-text);
  }

  .contribute-action:focus-visible,
  .contribution-path__actions a:focus-visible,
  .contribute-guidance__links a:focus-visible,
  .contributor-ranking__list a:focus-visible {
    outline: 2px solid var(--rc-focus);
    outline-offset: 3px;
  }

  .contribute-proof {
