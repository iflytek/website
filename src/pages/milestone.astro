---

<Layout metadata={metadata}>
  <div class="milestone-page">
    <header class="milestone-hero">
      <div class="milestone-shell milestone-hero__inner">
        <div class="milestone-hero__copy">
          <h1 data-lang-zh="开源里程碑" data-lang-en="Open-source milestones">开源里程碑</h1>
          <p
            data-lang-zh="记录 Astron 开源生态从技术突破、社区活跃到全球生态认可的重要时刻。"
            data-lang-en="A dated record of Astron's technical breakthroughs, community momentum, and growing recognition across the open-source ecosystem."
          >
            记录 Astron 开源生态从技术突破、社区活跃到全球生态认可的重要时刻。
          </p>
        </div>

        <div class="milestone-hero__index" aria-labelledby="milestone-index-label">
          <span
            id="milestone-index-label"
            class="milestone-index__label"
            data-lang-zh="里程碑索引"
            data-lang-en="Milestone index"
          >
            里程碑索引
          </span>
          <strong>
            <span data-lang-zh={periodZh} data-lang-en={periodEn}>{periodZh}</span>
          </strong>
          <span
            class="milestone-index__count"
            data-lang-zh={milestones.length + ' 条记录'}
            data-lang-en={milestones.length + ' records'}
          >
            {milestones.length} 条记录
          </span>
        </div>
      </div>

      <div class="milestone-shell">
        <span id="milestone-proof-label" class="sr-only" data-lang-zh="里程碑证据" data-lang-en="Milestone evidence">
          里程碑证据
        </span>
        <dl class="milestone-proof" aria-labelledby="milestone-proof-label">
          {
            stats.map((stat) => (
              <div class="milestone-proof__cell">
                <dt data-lang-zh={stat.labelZh} data-lang-en={stat.labelEn}>
                  {stat.labelZh}
                </dt>
                <dd>{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <section class="milestone-section milestone-timeline" aria-labelledby="milestone-timeline-title">
      <div class="milestone-shell">
        <header class="milestone-section__heading">
          <div>
            <h2 id="milestone-timeline-title" data-lang-zh="横向成就时间轴" data-lang-en="Achievement timeline">
              横向成就时间轴
            </h2>
            <p
              data-lang-zh="沿统一月份刻度查看 Astron 各项目的持续表现与单点成就。"
              data-lang-en="Compare Astron projects across one shared month scale, from sustained signals to point achievements."
            >
              沿统一月份刻度查看 Astron 各项目的持续表现与单点成就。
            </p>
          </div>
          <span
            class="milestone-section__count"
            data-lang-zh={ganttSignalCount + ' 个信号'}
            data-lang-en={ganttSignalCount + ' signals'}
          >
            {ganttSignalCount} 个信号
          </span>
        </header>

        <div class="milestone-timeline__legend" aria-label="图例 / Legend">
          <span>
            <span class="milestone-legend__range" aria-hidden="true"></span>
            <span data-lang-zh="持续时间段" data-lang-en="Sustained period">持续时间段</span>
          </span>
          <span>
            <span class="milestone-legend__point" aria-hidden="true"></span>
            <span data-lang-zh="单点里程碑" data-lang-en="Point milestone">单点里程碑</span>
          </span>
        </div>

        <p id="milestone-scroll-note" class="milestone-timeline__scroll-note">
          <span data-lang-zh="横向滑动查看完整时间轴" data-lang-en="Swipe horizontally to view the full timeline">
            横向滑动查看完整时间轴
          </span>
          <Icon name="tabler:arrows-horizontal" aria-hidden="true" />
        </p>

        <div class="milestone-gantt-frame">
          <div
            class="milestone-gantt-scroll"
            tabindex="0"
            role="region"
            aria-labelledby="milestone-timeline-title"
            aria-describedby="milestone-scroll-note milestone-gantt-description"
          >
            <div
              class="milestone-gantt"
              role="table"
              aria-label="Astron open source milestone timeline"
              aria-describedby="milestone-gantt-description"
            >
              <span
                id="milestone-gantt-description"
                class="sr-only"
                data-lang-zh="时间轴按月份排列，左侧显示项目与成就，右侧显示持续时间段或单点标记；部分记录会拆分为多个信号。"
                data-lang-en="The timeline is arranged by month. Projects and achievements are listed on the left, with sustained periods or point markers on the right; some records expand into multiple signals."
              >
                时间轴按月份排列，左侧显示项目与成就，右侧显示持续时间段或单点标记；部分记录会拆分为多个信号。
              </span>

              <div class="milestone-gantt__row milestone-gantt__header" role="row">
                <div class="milestone-gantt__label milestone-gantt__label--header" role="columnheader">
                  <span data-lang-zh="项目 / 成就" data-lang-en="Project / Achievement">项目 / 成就</span>
                </div>
                <div class="milestone-gantt__track milestone-gantt__track--months">
                  {
                    months.map((month, index) => (
                      <div class:list={['milestone-gantt__month', index === 4 && 'is-current']} role="columnheader">
                        <span data-lang-zh={month.zh} data-lang-en={month.en}>
                          {month.zh}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>

              {
                ganttGroups.map((group) => {
                  const project = projectMeta[group.project];
                  const groupId = `milestone-gantt-${group.project}`;

                  return (
                    <div class="milestone-gantt__group" role="rowgroup">
                      <div
                        class="milestone-gantt__row milestone-gantt__group-row"
                        role="row"
                        style={'--milestone-accent:' + project.accent}
                      >
                        <div class="milestone-gantt__label milestone-gantt__group-label" role="rowheader">
                          <span
                            class="milestone-gantt__project-dot"
                            style={'--milestone-accent:' + project.accent}
                            aria-hidden="true"
                          />
                          <span id={groupId} data-lang-zh={project.labelZh} data-lang-en={project.labelEn}>
                            {project.labelZh}
                          </span>
                          <span
                            class="milestone-gantt__group-count"
                            data-lang-zh={`${group.items.length} 项`}
                            data-lang-en={`${group.items.length} signals`}
                          >
                            {group.items.length} 项
                          </span>
                        </div>
                        <div class="milestone-gantt__track milestone-gantt__track--group" aria-hidden="true">
                          <div class="milestone-gantt__grid">
                            {months.map((_, index) => (
                              <span class:list={['milestone-gantt__grid-line', index === 4 && 'is-current']} />
                            ))}
                          </div>
                        </div>
                      </div>

                      {group.items.map((item, itemIndex) => {
                        const source = milestones[item.sourceIndex];
                        const gridEnd = (item.end ?? item.start) + 1;
                        const titleId = `milestone-gantt-title-${group.project}-${itemIndex}`;
                        const descriptionId = `milestone-gantt-description-${group.project}-${itemIndex}`;
                        const hasExternalLink = source.link?.href.startsWith('http') ?? false;

                        return (
                          <div class="milestone-gantt__row milestone-gantt__item" role="row">
                            <div class="milestone-gantt__label milestone-gantt__item-label" role="rowheader">
                              <span
                                class="milestone-gantt__icon"
                                style={'--milestone-accent:' + project.accent}
                                aria-hidden="true"
                              >
                                <Icon name={source.icon} />
                              </span>
                              <div class="milestone-gantt__item-copy">
                                <span
                                  id={titleId}
                                  class="milestone-gantt__item-title"
                                  data-lang-title-zh={item.titleZh}
                                  data-lang-title-en={item.titleEn}
                                  title={item.titleZh}
                                >
                                  <span data-lang-zh={item.titleZh} data-lang-en={item.titleEn}>
                                    {item.titleZh}
                                  </span>
                                </span>
                                <span class="milestone-gantt__item-meta">
                                  <time datetime={source.datetime}>
                                    <span data-lang-zh={item.dateZh} data-lang-en={item.dateEn}>
                                      {item.dateZh}
                                    </span>
                                  </time>
                                  {source.link ? (
                                    <a
                                      class="milestone-gantt__source-link"
                                      href={source.link.href}
                                      target={hasExternalLink ? '_blank' : undefined}
                                      rel={hasExternalLink ? 'noopener noreferrer' : undefined}
                                    >
                                      <Icon name="tabler:external-link" aria-hidden="true" />
                                      <span
                                        class="sr-only"
                                        data-lang-zh={`打开${item.titleZh}：${source.link.zh}${hasExternalLink ? '（新标签页）' : ''}`}
                                        data-lang-en={`Open ${item.titleEn}: ${source.link.en}${hasExternalLink ? ' (new tab)' : ''}`}
                                      >
                                        打开{item.titleZh}：{source.link.zh}
                                        {hasExternalLink ? '（新标签页）' : ''}
                                      </span>
                                    </a>
                                  ) : null}
                                </span>
                              </div>
                            </div>

                            <div
                              class="milestone-gantt__track milestone-gantt__track--item"
                              role="cell"
                              aria-labelledby={titleId}
                              aria-describedby={descriptionId}
                              data-lang-title-zh={source.descriptionZh}
                              data-lang-title-en={source.descriptionEn}
                              title={source.descriptionZh}
                            >
                              <div class="milestone-gantt__grid" aria-hidden="true">
                                {months.map((_, index) => (
                                  <span class:list={['milestone-gantt__grid-line', index === 4 && 'is-current']} />
                                ))}
                              </div>
                              {item.kind === 'range' ? (
                                <div
                                  class="milestone-gantt__range"
                                  style={`--milestone-accent:${project.accent};grid-column:${item.start} / ${gridEnd}`}
                                >
                                  <span data-lang-zh={item.barZh} data-lang-en={item.barEn}>
                                    {item.barZh}
                                  </span>
                                </div>
                              ) : (
                                <div class="milestone-gantt__point-wrap" style={`grid-column:${item.start}`}>
                                  <span
                                    class="milestone-gantt__point"
                                    style={'--milestone-accent:' + project.accent}
                                    aria-hidden="true"
                                  />
                                  <span class="milestone-gantt__point-label">
                                    <span data-lang-zh={item.barZh} data-lang-en={item.barEn}>
                                      {item.barZh}
                                    </span>
                                  </span>
                                </div>
                              )}
                              <span
                                id={descriptionId}
                                class="sr-only"
                                data-lang-zh={source.descriptionZh}
                                data-lang-en={source.descriptionEn}
                              >
                                {source.descriptionZh}
                              </span>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="milestone-next" aria-labelledby="milestone-next-title">
      <div class="milestone-shell milestone-next__inner">
        <div>
          <h2 id="milestone-next-title" data-lang-zh="继续探索 Astron" data-lang-en="Keep exploring Astron">
            继续探索 Astron
          </h2>
          <p
            data-lang-zh="从项目全景图与最新动态继续了解 Astron 开源生态。"
            data-lang-en="Continue with the project landscape and the latest Astron updates."
          >
            从项目全景图与最新动态继续了解 Astron 开源生态。
          </p>
        </div>
        <nav class="milestone-next__nav" aria-label="继续探索 / Continue exploring">
          <a href="/#project-landscape">
            <span data-lang-zh="探索项目全景" data-lang-en="Explore project landscape">探索项目全景</span>
            <Icon name="tabler:arrow-up-right" aria-hidden="true" />
