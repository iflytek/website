<Layout metadata={metadata}>
  <!-- Page Header -->
  <section
    class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white py-16 dark:from-gray-900 dark:to-gray-950 md:py-20"
  >
    <div class="absolute inset-0 opacity-30" aria-hidden="true">
      <div class="absolute left-1/4 top-1/4 h-64 w-64 rounded-full bg-primary-400 blur-[100px]"></div>
      <div class="absolute right-1/4 bottom-1/4 h-64 w-64 rounded-full bg-accent-400 blur-[100px]"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary-200/80 bg-white/70 px-4 py-2 text-sm font-semibold text-primary-700 shadow-sm backdrop-blur dark:border-primary-800 dark:bg-gray-900/60 dark:text-primary-300"
        >
          <Icon name="tabler:sparkles" class="h-4 w-4" />
          <span data-lang-zh="Astron 开源生态" data-lang-en="Astron Open Source Ecosystem">Astron 开源生态</span>
        </div>
        <h1 class="flex items-center justify-center text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
          <span
            class="bg-gradient-to-r from-gradient-start to-gradient-end bg-clip-text text-transparent"
            data-lang-zh="开源里程碑"
            data-lang-en="Milestone"
          >
            开源里程碑
          </span>
        </h1>
        <p
          class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-gray-600 dark:text-gray-400"
          data-lang-zh="记录 Astron 开源生态从技术突破、社区活跃到全球生态认可的重要时刻"
          data-lang-en="Key moments in the Astron open source ecosystem, from technical breakthroughs and community momentum to global recognition"
        >
          记录 Astron 开源生态从技术突破、社区活跃到全球生态认可的重要时刻
        </p>
      </div>
      <div class="mx-auto mt-12 grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="group rounded-2xl border border-white/80 bg-white/70 p-5 text-center shadow-lg shadow-primary-900/5 backdrop-blur transition-all hover:-translate-y-1 hover:shadow-xl dark:border-gray-700/70 dark:bg-gray-900/70">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-primary-100 text-primary-600 transition-transform group-hover:scale-110 dark:bg-primary-950 dark:text-primary-300">
                <Icon name={stat.icon} class="h-5 w-5" />
              </div>
              <div class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">{stat.value}</div>
              <div
                class="mt-1 text-sm leading-snug text-gray-500 dark:text-gray-400"
                data-lang-zh={stat.labelZh}
                data-lang-en={stat.labelEn}
              >
                {stat.labelZh}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="relative overflow-hidden py-14 md:py-20">
    <div class="pointer-events-none absolute inset-0 -z-10 opacity-50 dark:opacity-20" aria-hidden="true">
      <div
        class="absolute left-1/2 top-1/3 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-primary-100 blur-[120px] dark:bg-primary-950"
      >
      </div>
    </div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 text-center md:mb-16">
        <p
          class="text-sm font-bold uppercase tracking-[0.24em] text-primary-600 dark:text-primary-400"
          data-lang-zh="2025.09 — 2026.08"
          data-lang-en="SEP 2025 — AUG 2026"
        >
          2025.09 — 2026.08
        </p>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl"
          data-lang-zh="横向成就时间轴"
          data-lang-en="Achievement timeline"
        >
          横向成就时间轴
        </h2>
      </div>

      <div
        class="mb-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-gray-600 dark:text-gray-400"
      >
        <span class="flex items-center gap-2">
          <span class="h-3 w-10 rounded-full bg-gradient-to-r from-sky-500 to-indigo-600"></span>
          <span data-lang-zh="持续时间段" data-lang-en="Sustained period">持续时间段</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="h-3 w-3 rotate-45 rounded-[3px] bg-primary-500"></span>
          <span data-lang-zh="单点里程碑" data-lang-en="Point milestone">单点里程碑</span>
        </span>
      </div>
      <p class="mb-3 text-sm font-medium text-gray-500 md:hidden dark:text-gray-400">
        <span class="i18n-zh">左右滑动查看完整时间轴</span>
        <span class="i18n-en">Swipe horizontally to view the full timeline</span>
        <Icon name="tabler:arrows-horizontal" class="ml-1 inline h-4 w-4" />
      </p>

      <div
        class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl shadow-gray-900/5 dark:border-gray-800 dark:bg-gray-900"
      >
        <div class="overflow-x-auto [scrollbar-color:theme(colors.primary.300)_transparent]">
          <div class="min-w-[1240px]" role="table" aria-label="Astron open source milestone timeline">
            <div
              class="grid grid-cols-[280px_960px] border-b border-gray-200 bg-gray-50/90 dark:border-gray-700 dark:bg-gray-950/70"
              role="row"
            >
              <div class="flex items-center px-5 py-4 text-xs font-bold uppercase tracking-wider text-gray-500">
                <span class="i18n-zh">项目 / 成就</span>
                <span class="i18n-en">Project / Achievement</span>
              </div>
              <div class="grid grid-cols-12">
                {
                  months.map((month, index) => (
                    <div
                      class:list={[
                        'border-l border-gray-200 px-1 py-3 text-center font-mono text-[11px] font-bold text-gray-500 dark:border-gray-700 dark:text-gray-400',
                        index === 4 && 'bg-primary-50/60 dark:bg-primary-950/30',
                      ]}
                      role="columnheader"
                    >
                      <span class="i18n-zh">{month.zh}</span>
                      <span class="i18n-en">{month.en}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            {
              ganttGroups.map((group) => {
                const theme = projectThemes[group.project];

                return (
                  <div role="rowgroup">
                    <div
                      class:list={[
                        'grid grid-cols-[280px_960px] border-b border-gray-200 dark:border-gray-800',
                        theme.soft,
                      ]}
                      role="row"
                    >
                      <div class="flex items-center gap-3 px-5 py-3">
                        <span class:list={['h-2.5 w-2.5 rounded-full shadow-md', theme.dot]} />
                        <span class="text-sm font-extrabold text-gray-900 dark:text-white">{theme.label}</span>
                        <span class="rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-bold text-gray-500 dark:bg-gray-900/70 dark:text-gray-400">
                          {group.items.length}
                        </span>
                      </div>
                      <div class="relative">
                        <div class="absolute inset-0 grid grid-cols-12" aria-hidden="true">
                          {months.map(() => (
                            <span class="border-l border-gray-200/80 dark:border-gray-800" />
                          ))}
                        </div>
                      </div>
                    </div>

                    {group.items.map((item) => {
                      const source = milestones[item.sourceIndex];
                      const gridEnd = (item.end ?? item.start) + 1;

                      return (
                        <div
                          class="grid min-h-[68px] grid-cols-[280px_960px] border-b border-gray-100 last:border-b-0 dark:border-gray-800/80"
                          role="row"
                        >
                          <div class="flex min-w-0 items-center gap-3 px-5 py-3" role="rowheader">
                            <div
                              class:list={[
                                'flex h-9 w-9 shrink-0 items-center justify-center rounded-lg shadow-md',
                                theme.icon,
                              ]}
                            >
                              <Icon name={source.icon} class="h-4 w-4" />
                            </div>
                            <div class="min-w-0 flex-1">
                              <div class="truncate text-[13px] font-bold text-gray-800 dark:text-gray-100">
                                <span class="i18n-zh">{item.titleZh}</span>
                                <span class="i18n-en">{item.titleEn}</span>
                              </div>
                              <div class="mt-1 flex items-center gap-2 font-mono text-[11px] font-semibold text-gray-400">
                                <span class="i18n-zh">{item.dateZh}</span>
                                <span class="i18n-en">{item.dateEn}</span>
                                {source.link && (
                                  <a
                                    href={source.link.href}
                                    target={source.link.href.startsWith('http') ? '_blank' : undefined}
                                    rel={source.link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                                    class="text-primary-500 transition-colors hover:text-primary-700"
                                    aria-label={source.link.zh}
                                  >
                                    <Icon name="tabler:external-link" class="h-3.5 w-3.5" />
                                  </a>
                                )}
                              </div>
                            </div>
                          </div>

                          <div class="relative grid grid-cols-12 items-center" role="cell" title={source.descriptionZh}>
                            <div class="pointer-events-none absolute inset-0 grid grid-cols-12" aria-hidden="true">
                              {months.map(() => (
                                <span class="border-l border-gray-100 dark:border-gray-800/80" />
                              ))}
                            </div>
                            {item.kind === 'range' ? (
                              <div
                                class:list={[
                                  'relative z-10 mx-1.5 flex h-9 items-center overflow-hidden rounded-lg bg-gradient-to-r px-3 text-xs font-extrabold text-white shadow-lg',
                                  theme.bar,
                                ]}
                                style={`grid-column: ${item.start} / ${gridEnd}`}
                              >
                                <span class="truncate i18n-zh">{item.barZh}</span>
                                <span class="truncate i18n-en">{item.barEn}</span>
                              </div>
                            ) : (
                              <div
                                class="relative z-10 flex h-full items-center justify-center"
                                style={`grid-column: ${item.start}`}
                              >
                                <div class="relative flex items-center">
                                  <span
                                    class:list={[
                                      'absolute left-0 h-4 w-4 -translate-x-1/2 rotate-45 rounded-[4px] border-4 shadow-lg',
                                      theme.point,
                                    ]}
                                  />
                                  <span
                                    class:list={[
                                      'ml-2.5 w-max min-w-[84px] rounded-full border bg-white px-2.5 py-1.5 text-[11px] font-extrabold shadow-md dark:bg-gray-900',
                                      theme.badge,
                                    ]}
                                  >
                                    <span class="i18n-zh">{item.barZh}</span>
                                    <span class="i18n-en">{item.barEn}</span>
                                  </span>
                                </div>
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing statement -->
  <section class="pb-16 md:pb-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-primary-600 to-sky-500 px-6 py-10 text-center text-white shadow-2xl shadow-primary-900/20 md:px-12 md:py-14"
      >
        <div class="absolute inset-0 opacity-20" aria-hidden="true">
          <div class="absolute -left-8 -top-16 h-48 w-48 rounded-full border border-white/60"></div>
          <div class="absolute -bottom-24 -right-12 h-64 w-64 rounded-full border border-white/60"></div>
        </div>
        <div class="relative mx-auto max-w-3xl">
          <Icon name="tabler:world" class="mx-auto h-9 w-9 text-white/90" />
          <h2
            class="mt-4 text-2xl font-bold md:text-3xl"
            data-lang-zh="持续生长的全球开源影响力"
            data-lang-en="Growing global open-source impact"
          >
            持续生长的全球开源影响力
          </h2>
          <p
            class="mt-4 text-base leading-7 text-white/85 md:text-lg"
            data-lang-zh="Astron Agent、Astron RPA 与 SkillHub 在两个月内接力登上 GitHub Trending，从单点突破走向持续性的全球开发者社区影响。"
            data-lang-en="Astron Agent, Astron RPA, and SkillHub reached GitHub Trending in succession within two months, turning individual breakthroughs into sustained influence across the global developer community."
          >
            Astron Agent、Astron RPA 与 SkillHub 在两个月内接力登上 GitHub
            Trending，从单点突破走向持续性的全球开发者社区影响。
          </p>
          <a
            href="/#project-landscape"
            class="mt-7 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-primary-700 shadow-lg transition-all hover:-translate-y-0.5 hover:bg-primary-50 hover:shadow-xl"
          >
            <span data-lang-zh="探索 Astron 开源全景图" data-lang-en="Explore the Astron Landscape">
              探索 Astron 开源全景图
            </span>
            <Icon name="tabler:arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
