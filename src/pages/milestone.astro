</Layout>

<script>
  (() => {
    const syncMilestoneTitles = () => {
      const language = document.documentElement.lang === 'en' ? 'en' : 'zh';
      document.querySelectorAll('[data-lang-title-zh]').forEach((element) => {
        const title = element.getAttribute(`data-lang-title-${language}`);
        if (title) element.setAttribute('title', title);
      });
    };

    const initMilestoneGanttKeyboard = () => {
      document.querySelectorAll('.milestone-gantt-scroll').forEach((node) => {
        if (!(node instanceof HTMLElement) || node.dataset.keyboardScroll === 'true') return;
        node.dataset.keyboardScroll = 'true';
        node.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;

          event.preventDefault();
          const distance = Math.max(160, node.clientWidth * 0.72);
          const left =
            event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? node.scrollWidth - node.clientWidth
                : node.scrollLeft + (event.key === 'ArrowRight' ? distance : -distance);

          node.scrollTo({
            left,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });
      });
    };

    syncMilestoneTitles();
    initMilestoneGanttKeyboard();
    document.addEventListener('languagechange', syncMilestoneTitles);
    document.addEventListener('astro:after-swap', () => {
      syncMilestoneTitles();
      initMilestoneGanttKeyboard();
      window.requestAnimationFrame(syncMilestoneTitles);
    });
  })();
</script>

