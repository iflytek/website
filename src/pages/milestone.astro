---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '开源里程碑',
  description:
    'Milestones of the iFLYTEK Astron open source ecosystem across community rankings, global trends, ecosystem recognition, and industry awards.',
};

type ProjectKey = 'agent' | 'rpa' | 'skillhub' | 'ecosystem';

const projectMeta: Record<ProjectKey, { labelZh: string; labelEn: string; accent: string }> = {
