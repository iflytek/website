  rpa: { labelZh: 'Astron RPA', labelEn: 'Astron RPA', accent: 'var(--rc-cyan)' },
  skillhub: { labelZh: 'SkillHub', labelEn: 'SkillHub', accent: 'var(--rc-violet)' },
  ecosystem: {
    labelZh: 'Astron 生态',
    labelEn: 'Astron ecosystem',
    accent: 'var(--rc-amber)',
