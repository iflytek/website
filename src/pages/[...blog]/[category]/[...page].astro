---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogArchive from '~/components/blog/BlogArchive.astro';

import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';
import { getBlogSection, type BlogSectionKey } from '~/data/blog-sections';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const lastPage = page.lastPage ?? 1;
const total = page.total ?? page.data.length;
const section = getBlogSection(category.slug);
const titleZh = section?.titleZh || category.title;
const titleEn = section?.titleEn || category.title;
const descriptionZh = section?.descriptionZh || `${category.title} 相关文章`;

const metadata = {
  title: `${titleZh}${currentPage > 1 ? ` — 第 ${currentPage} 页` : ''}`,
  description: descriptionZh,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};

const activeSection: BlogSectionKey | null = section?.key === 'tech' || section?.key === 'news' ? section.key : null;
---

<Layout metadata={metadata}>
  <BlogArchive
    posts={page.data}
    titleZh={titleZh}
    titleEn={titleEn}
    activeSection={activeSection}
    total={total}
    currentPage={currentPage}
    lastPage={lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    showCategory={false}
  />
</Layout>
