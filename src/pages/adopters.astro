---
import Layout from '~/layouts/PageLayout.astro';
import AdopterMarqueeCard from '~/components/adopters/AdopterMarqueeCard.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Adopters',
  description: '探索 Astron 开源生态中的真实用户案例、落地方式与应用成果。',
};

const adopters = await getCollection('adopter');
const reversedAdopters = [...adopters].reverse();
---

<Layout metadata={metadata}>
  <section class="adopters-page" data-adopters-page>
    <header class="adopters-hero">
      <div class="adopters-page__shell">
        <h1 data-lang-zh="用户案例" data-lang-en="Adopters">用户案例</h1>
        <p data-i18n="adopters.subtitle">
          探索 Astron 开源生态的用户案例，了解各行业如何利用 AI Agent 平台实现业务创新
        </p>
      </div>
    </header>

    <section class="adopters-track-section adopters-track-section--left" aria-labelledby="adopters-left-title">
      <h2
        id="adopters-left-title"
        class="sr-only"
        data-lang-zh="用户案例，向左滚动"
        data-lang-en="Adopter cases, moving left"
      >
        用户案例，向左滚动
      </h2>
      <adopter-marquee
        class="adopters-marquee marquee-left"
        data-direction="left"
        data-speed="30"
        aria-labelledby="adopters-left-title"
      >
        <div class="adopters-marquee__viewport">
          <div class="adopters-marquee__track" data-marquee-track>
            <ul class="adopters-marquee__sequence" data-marquee-sequence role="list">
              {adopters.map((adopter) => <AdopterMarqueeCard adopter={adopter} row="left" copy={0} />)}
            </ul>
            <ul class="adopters-marquee__sequence" aria-hidden="true" role="list">
              {adopters.map((adopter) => <AdopterMarqueeCard adopter={adopter} row="left" copy={1} />)}
            </ul>
          </div>
        </div>
      </adopter-marquee>
    </section>

    <section class="adopters-track-section adopters-track-section--right" aria-labelledby="adopters-right-title">
      <h2
        id="adopters-right-title"
        class="sr-only"
        data-lang-zh="用户案例，向右滚动"
        data-lang-en="Adopter cases, moving right"
      >
        用户案例，向右滚动
      </h2>
      <adopter-marquee
        class="adopters-marquee marquee-right"
        data-direction="right"
        data-speed="30"
        aria-labelledby="adopters-right-title"
      >
        <div class="adopters-marquee__viewport">
          <div class="adopters-marquee__track" data-marquee-track>
            <ul class="adopters-marquee__sequence" data-marquee-sequence role="list">
              {reversedAdopters.map((adopter) => <AdopterMarqueeCard adopter={adopter} row="right" copy={0} />)}
            </ul>
            <ul class="adopters-marquee__sequence" aria-hidden="true" role="list">
              {reversedAdopters.map((adopter) => <AdopterMarqueeCard adopter={adopter} row="right" copy={1} />)}
            </ul>
          </div>
        </div>
      </adopter-marquee>
    </section>

    <p class="adopters-disclaimer">
      <span class="adopters-disclaimer__mark" aria-hidden="true">*</span>
      <span data-i18n="adopters.disclaimer">以上案例已获用户授权同意展示</span>
    </p>
  </section>
</Layout>

<style is:global>
  .adopters-page {
    min-height: 70vh;
    overflow: hidden;
    padding: 0 0 clamp(5rem, 9vw, 8rem);
    background: var(--rc-canvas);
    color: var(--rc-text);
  }

  .adopters-page__shell {
    width: min(calc(100% - 3rem), 87.5rem);
    margin-inline: auto;
  }

  .adopters-hero {
    padding: clamp(3.75rem, 7vw, 6.5rem) 0 clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--rc-rule);
    text-align: center;
  }

  .adopters-hero h1 {
    margin: 0;
    color: var(--rc-text-strong);
    font-size: var(--rc-type-section-heading);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .adopters-hero p {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    color: var(--rc-text-muted);
    font-size: 1rem;
    line-height: 1.68;
  }

  .adopters-track-section {
    padding: 2.5rem 0 0;
  }

  .adopters-track-section--right {
    padding-top: 1.25rem;
  }

  .adopters-marquee {
    display: block;
    width: 100%;
  }

  .adopters-marquee__viewport {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      var(--rc-text-strong) 4%,
      var(--rc-text-strong) 96%,
      transparent
    );
  }

  .adopters-marquee__track {
    display: flex;
    width: max-content;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  /* Keep the complete case sequence reachable when motion is unavailable. */
  .adopters-marquee:not([data-bound]) .adopters-marquee__viewport {
    overflow-x: auto;
    mask-image: none;
    scrollbar-color: var(--rc-rule-strong) transparent;
    scrollbar-width: thin;
  }

  .adopters-marquee:not([data-bound]) .adopters-marquee__track {
    transform: none !important;
    will-change: auto;
  }

  .adopters-marquee:not([data-bound]) .adopters-marquee__sequence[aria-hidden='true'] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .adopters-marquee__viewport {
      overflow-x: auto;
      mask-image: none;
      scrollbar-color: var(--rc-rule-strong) transparent;
      scrollbar-width: thin;
    }

    .adopters-marquee__track {
      transform: none !important;
      will-change: auto;
    }

    .adopters-marquee__sequence[aria-hidden='true'] {
      display: none;
    }
  }

  .adopters-marquee__sequence {
    display: flex;
    flex: 0 0 auto;
    gap: 1rem;
    margin: 0;
    padding: 0 1rem 0 0;
    list-style: none;
  }

  .adopters-marquee__item {
    display: flex;
    flex: 0 0 auto;
    width: min(22rem, calc(100vw - 2rem));
  }

  .adopters-card {
    display: flex;
    width: 100%;
    min-height: 18.5rem;
    flex-direction: column;
    padding: 1.375rem;
    border: 1px solid var(--rc-rule);
    border-radius: var(--rc-radius-surface);
    background: color-mix(in srgb, var(--rc-surface) 92%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .adopters-card:focus-visible {
    position: relative;
    z-index: 1;
    border-color: var(--rc-focus);
    outline: 2px solid var(--rc-focus);
    outline-offset: 2px;
  }

  .adopters-card__identity {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 1rem;
  }

  .adopters-card__logo {
    display: grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 auto;
    place-items: center;
    padding: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--rc-rule-strong);
    border-radius: var(--rc-radius-control);
    background: #ffffff;
  }

  .adopters-card__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .adopters-card__identity-copy {
    display: grid;
    min-width: 0;
    gap: 0.35rem;
    padding-top: 0.2rem;
  }

  .adopters-card__identity-copy h2 {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--rc-text-strong);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .adopters-card__identity-copy > span {
    overflow-wrap: anywhere;
    color: var(--rc-text-faint);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .adopters-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    color: var(--rc-text-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.035em;
    line-height: 1.45;
    list-style: none;
    text-transform: uppercase;
  }

  .adopters-card__tags li {
    position: relative;
    overflow-wrap: anywhere;
  }

  .adopters-card__tags li:not(:last-child)::after {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.35rem);
    color: var(--rc-rule-strong);
    content: '·';
    transform: translateY(-52%);
  }

  .adopters-card__scenario {
    margin: 1.25rem 0 0;
    color: var(--rc-text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .adopters-disclaimer {
    display: flex;
    width: min(calc(100% - 3rem), 87.5rem);
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin: 2.5rem auto 0;
    color: var(--rc-text-faint);
    font-size: 0.8125rem;
    line-height: 1.6;
    text-align: center;
  }

  .adopters-disclaimer__mark {
    display: inline-block;
    flex: 0 0 auto;
    line-height: 1;
    transform: translateY(0.08em);
  }

  @media (hover: hover) {
    .adopters-card:hover {
      border-color: var(--rc-rule-strong);
      background: var(--rc-band);
    }
  }

  @media (max-width: 64rem) {
    .adopters-page__shell,
    .adopters-disclaimer {
      width: min(calc(100% - 2rem), 87.5rem);
    }

    .adopters-marquee__sequence {
      gap: 0.875rem;
      padding-right: 0.875rem;
    }

    .adopters-marquee__item {
      width: min(21rem, calc(100vw - 1.5rem));
    }
  }

  @media (max-width: 42rem) {
    .adopters-page__shell,
    .adopters-disclaimer {
      width: calc(100% - 1.5rem);
    }

    .adopters-hero {
      padding-top: 2.75rem;
      padding-bottom: 2.5rem;
      text-align: left;
    }

    .adopters-hero p {
      margin-top: 1rem;
    }

    .adopters-track-section {
      padding-top: 2rem;
    }

    .adopters-track-section--right {
      padding-top: 1rem;
    }

    .adopters-marquee__viewport {
      mask-image: linear-gradient(
        to right,
        transparent,
        var(--rc-text-strong) 8%,
        var(--rc-text-strong) 92%,
        transparent
      );
    }

    .adopters-marquee__item {
      width: min(20rem, calc(100vw - 1.5rem));
    }

    .adopters-card {
      min-height: 17.5rem;
      padding: 1.25rem;
    }
  }

  @media (max-width: 30rem) {
    .adopters-marquee__sequence {
      gap: 0.75rem;
      padding-right: 0.75rem;
    }

    .adopters-marquee__item {
      width: calc(100vw - 1.5rem);
    }

    .adopters-card__identity {
      gap: 0.875rem;
    }

    .adopters-card__logo {
      width: 3.5rem;
      height: 3.5rem;
      padding: 0.45rem;
    }

    .adopters-card__tags li:not(:last-child)::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .adopters-card {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const ELEMENT_NAME = 'adopter-marquee';

    if (customElements.get(ELEMENT_NAME)) return;

    class AdopterMarqueeElement extends HTMLElement {
      constructor() {
        super();
        this.track = null;
        this.sequence = null;
        this.frame = undefined;
        this.resizeObserver = undefined;
        this.intersectionObserver = undefined;
        this.abortController = undefined;
        this.lastTimestamp = undefined;
        this.offset = 0;
        this.distance = 0;
        this.hovered = false;
        this.focused = false;
        this.visible = false;
        this.reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      }

      connectedCallback() {
        if (this.hasAttribute('data-bound')) return;
        this.setAttribute('data-bound', '');
        this.track = this.querySelector('[data-marquee-track]');
        this.sequence = this.querySelector('[data-marquee-sequence]');
        if (!this.track || !this.sequence) return;

        this.abortController = new AbortController();
        const { signal } = this.abortController;
        this.addEventListener('pointerenter', () => this.setHovered(true), { signal });
        this.addEventListener('pointerleave', () => this.setHovered(false), { signal });
        this.addEventListener('focusin', () => this.setFocused(true), { signal });
        this.addEventListener(
          'focusout',
          () => requestAnimationFrame(() => this.setFocused(this.contains(document.activeElement))),
          { signal }
        );
        document.addEventListener('visibilitychange', () => this.refreshAnimation(), { signal });
        this.reduceMotion.addEventListener('change', () => this.refreshAnimation(), { signal });

        if (typeof ResizeObserver === 'function') {
          this.resizeObserver = new ResizeObserver(() => this.measure());
          this.resizeObserver.observe(this);
          this.resizeObserver.observe(this.sequence);
        }
        this.measure();

        if (typeof IntersectionObserver === 'function') {
          this.intersectionObserver = new IntersectionObserver(
            ([entry]) => {
              this.visible = entry.isIntersecting;
              this.refreshAnimation();
            },
            { threshold: 0.05 }
          );
          this.intersectionObserver.observe(this);
        } else {
          this.visible = true;
          this.refreshAnimation();
        }
      }

      disconnectedCallback() {
        this.stopAnimation();
        this.resizeObserver?.disconnect();
        this.intersectionObserver?.disconnect();
        this.abortController?.abort();
        this.removeAttribute('data-bound');
      }

      measure() {
        if (!this.sequence || !this.track) return;
        const sequenceWidth = this.sequence.getBoundingClientRect().width;
        if (!sequenceWidth) return;
        const previousDistance = this.distance;
        this.distance = sequenceWidth;
        if (!previousDistance) {
          this.offset = this.dataset.direction === 'right' ? this.distance : 0;
        } else {
          this.offset = ((this.offset % this.distance) + this.distance) % this.distance;
        }
        this.applyTransform();
        this.refreshAnimation();
      }

      setHovered(value) {
        this.hovered = value;
        this.refreshAnimation();
      }

      setFocused(value) {
        this.focused = value;
        this.refreshAnimation();
      }

      canAnimate() {
        return Boolean(
          this.track &&
          this.distance > 0 &&
          this.visible &&
          !this.reduceMotion.matches &&
          !this.hovered &&
          !this.focused &&
          !document.hidden &&
          !navigator.connection?.saveData
        );
      }

      refreshAnimation() {
        if (this.canAnimate()) {
          if (this.frame === undefined) {
            this.lastTimestamp = undefined;
            this.frame = requestAnimationFrame((timestamp) => this.tick(timestamp));
          }
        } else {
          this.stopAnimation();
        }
      }

      stopAnimation() {
        if (this.frame !== undefined) cancelAnimationFrame(this.frame);
        this.frame = undefined;
        this.lastTimestamp = undefined;
        if (this.reduceMotion.matches && this.distance) {
          this.offset = this.dataset.direction === 'right' ? this.distance : 0;
          this.applyTransform();
        }
      }

      tick(timestamp) {
        if (!this.canAnimate()) {
          this.stopAnimation();
          return;
        }

        if (this.lastTimestamp === undefined) this.lastTimestamp = timestamp;
        const delta = Math.min(64, Math.max(0, timestamp - this.lastTimestamp)) / 1000;
        this.lastTimestamp = timestamp;
        const speed = Number(this.dataset.speed) || 30;
        const direction = this.dataset.direction === 'right' ? -1 : 1;
        this.offset = (this.offset + direction * speed * delta + this.distance) % this.distance;
        this.applyTransform();
        this.frame = requestAnimationFrame((nextTimestamp) => this.tick(nextTimestamp));
      }

      applyTransform() {
        if (this.track) this.track.style.transform = `translate3d(${-this.offset}px, 0, 0)`;
      }
    }

    customElements.define(ELEMENT_NAME, AdopterMarqueeElement);
  })();
</script>
